# Miniaturas del selector de habitaciones.
# Las genera scripts/optimiza-selector.mjs en cada "prebuild", a partir
# de los JPG que si estan versionados, asi que Vercel las recrea sola en
# cada despliegue. Versionarlas seria guardar 364 KB de salida de build
# que cambia cada vez que se toca una foto. Ojo: solo los anchos que
# genera ese script. Las variantes del hero -400, 600, 700 y 900- se
# hicieron a mano y siguen versionadas.
public/assets/img/hospedajes/*-240.avif
public/assets/img/hospedajes/*-240.webp
public/assets/img/hospedajes/*-360.avif
public/assets/img/hospedajes/*-360.webp
public/assets/img/hospedajes/*-480.avif
public/assets/img/hospedajes/*-480.webp

# Variantes por ancho de las fichas nuevas: las regenera el prebuild
# (scripts/optimiza-selector.mjs) a partir de los originales, que si
# estan versionados. Las del hero de Hotel Atheron Suite se hicieron a
# mano antes de que existiera el script y siguen versionadas.
public/assets/img/hospedajes/*/*-240.avif
public/assets/img/hospedajes/*/*-240.webp
public/assets/img/hospedajes/*/*-360.avif
public/assets/img/hospedajes/*/*-360.webp
public/assets/img/hospedajes/*/*-480.avif
public/assets/img/hospedajes/*/*-480.webp
public/assets/img/hospedajes/*/*-400.avif
public/assets/img/hospedajes/*/*-400.webp
public/assets/img/hospedajes/*/*-600.avif
public/assets/img/hospedajes/*/*-600.webp
public/assets/img/hospedajes/*/*-700.avif
public/assets/img/hospedajes/*/*-700.webp
public/assets/img/hospedajes/*/*-900.avif
public/assets/img/hospedajes/*/*-900.webp

# Variantes de la foto que usa la portada en "Como nacio Atheron Suite".
# Las genera el prebuild igual que las de las fichas. Se nombran una a
# una y no con un comodin porque en esta carpeta -sin subcarpeta- si hay
# variantes versionadas a proposito: las del hero de Hotel Atheron Suite,
# hechas a mano antes de que existiera el script.
public/assets/img/hospedajes/la-magia-de-zipaquira-301-camas-400.avif
public/assets/img/hospedajes/la-magia-de-zipaquira-301-camas-400.webp
public/assets/img/hospedajes/la-magia-de-zipaquira-301-camas-600.avif
public/assets/img/hospedajes/la-magia-de-zipaquira-301-camas-600.webp
public/assets/img/hospedajes/la-magia-de-zipaquira-301-camas-700.avif
public/assets/img/hospedajes/la-magia-de-zipaquira-301-camas-700.webp
public/assets/img/hospedajes/la-magia-de-zipaquira-301-camas-900.avif
public/assets/img/hospedajes/la-magia-de-zipaquira-301-camas-900.webp

# Grafo de Graphify. Es artefacto GENERADO, no fuente: lo reconstruye
# "graphify extract . --code-only" en segundos y sin coste de API. No se
# versiona porque cambia con cada tanda de codigo y son ~1,1 MB por
# reconstruccion. En una sesion nueva -local o en la nube- se regenera
# antes de cualquier trabajo amplio; ver la seccion graphify de CLAUDE.md.
graphify-out/

