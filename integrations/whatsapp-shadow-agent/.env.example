# GOAL-WHATSAPP-AGENT-001 -- solo banderas, ningun secreto.
# Kill switch: con false el agente no analiza ni responde nada (por defecto).
WHATSAPP_AUTOMATION_ENABLED=false
# Solo "shadow" esta habilitado. supervised / auto_offhours / auto existen pero fallan cerrado.
WHATSAPP_AUTOMATION_MODE=shadow
