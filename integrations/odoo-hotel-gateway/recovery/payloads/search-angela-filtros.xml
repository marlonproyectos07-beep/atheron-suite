<!--
  BORRADOR (no probado en Odoo). Filtros de "Modo Ángela" sobre sale.order, solo con campos reales confirmados
  (x_checkin y x_checkout son DATE; x_reservation_status tiene 10 valores; x_hold_expired es boolean).
  Se instala como extensión del search view de sale.order resuelto por nombre (ver r7-angela-board.mjs).
  Ventanas (APROBADAS 2026-10-10): una reserva "cae" en la ventana si
  x_checkin <= fin_ventana  Y  x_checkout >= inicio_ventana  (incluye llegadas y salidas del propio día).
    HOY    = [hoy, hoy]          MAÑANA = [hoy+1, hoy+1]
    7 DÍAS = [hoy, hoy+6]        MES    = [primer día del mes, último día del mes]
  Las ventanas (HOY/MAÑANA/7 DÍAS/MES) APROBADAS: HOY = fecha actual; MAÑANA = día siguiente; 7 DÍAS = hoy + 6 siguientes;
  MES = mes calendario actual. Entre <separator/> los filtros se combinan con OR; entre grupos, con AND.
  Estas ventanas filtran el listado (estancias que se solapan); los KPI se calculan en angela-board-model.mjs.
-->
<data>
  <xpath expr="//search" position="inside">
    <!-- Ventanas -->
    <filter name="ang_hoy" string="HOY"
            domain="[('x_checkin','&lt;=',context_today().strftime('%Y-%m-%d')),('x_checkout','&gt;=',context_today().strftime('%Y-%m-%d'))]"/>
    <filter name="ang_manana" string="MAÑANA"
            domain="[('x_checkin','&lt;=',(context_today()+datetime.timedelta(days=1)).strftime('%Y-%m-%d')),('x_checkout','&gt;=',(context_today()+datetime.timedelta(days=1)).strftime('%Y-%m-%d'))]"/>
    <filter name="ang_7dias" string="7 DÍAS"
            domain="[('x_checkin','&lt;=',(context_today()+datetime.timedelta(days=6)).strftime('%Y-%m-%d')),('x_checkout','&gt;=',context_today().strftime('%Y-%m-%d'))]"/>
    <filter name="ang_mes" string="MES"
            domain="[('x_checkin','&lt;=',(context_today()+relativedelta(day=31)).strftime('%Y-%m-%d')),('x_checkout','&gt;=',context_today().strftime('%Y-%m-01'))]"/>
    <separator/>
    <!-- Solo operación real: mismo criterio que el filtro «Operación real (oculta QA)»; recomendado activo por defecto -->
    <filter name="ang_real" string="Solo operación real"
            domain="['!','|','|','|',('partner_id.name','ilike','QA-'),('partner_id.name','ilike','FICTICIO'),('partner_id.name','ilike','TEST'),('partner_id.name','=','Cliente WhatsApp')]"/>
    <separator/>
    <!-- Operación comercial -->
    <filter name="ang_llegan_hoy" string="Llegadas hoy"
            domain="[('x_checkin','=',context_today().strftime('%Y-%m-%d')),('x_reservation_status','in',['confirmed','pre_checkin','checked_in','checked_out','closed'])]"/>
    <filter name="ang_salen_hoy" string="Salidas hoy"
            domain="[('x_checkout','=',context_today().strftime('%Y-%m-%d')),('x_reservation_status','in',['checked_in','checked_out','closed'])]"/>
    <!-- OCUPADAS = ocupación FÍSICA: solo checked_in. Una reserva que cruza la fecha sin check-in NO es ocupada. -->
    <filter name="ang_ocupadas" string="Ocupadas (en casa)"
            domain="[('x_reservation_status','=','checked_in')]"/>
    <!-- CONFIRMADA (aprobado): estado post-confirmación, real, no cancelada, no solo HOLD.
         PENDIENTE: el criterio comercial por propiedad/acuerdo aún no está definido; este filtro NO lo aplica. -->
    <filter name="ang_confirmadas" string="Confirmadas (criterio comercial PENDIENTE)"
            domain="[('x_reservation_status','in',['confirmed','pre_checkin','checked_in','checked_out','closed'])]"/>
    <separator/>
    <!-- Inventario no vendible -->
    <filter name="ang_hold" string="HOLD vigente"
            domain="[('x_reservation_status','=','hold'),('x_hold_expired','=',False)]"/>
    <separator/>
    <!-- Financiero. PROVISIONAL: x_hotel_balance es el saldo de Odoo; SALDO_REAL (solo pagos CONFIRMED) se calcula en
         angela-board-model.mjs. No se sustituye hasta saber cómo Odoo calcula x_hotel_balance. -->
    <filter name="ang_con_saldo" string="Con saldo (provisional)"
            domain="[('x_hotel_balance','&gt;',0),('x_reservation_status','in',['confirmed','pre_checkin','checked_in','checked_out','closed'])]"/>
  </xpath>
</data>
