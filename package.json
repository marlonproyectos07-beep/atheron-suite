{
  "name": "atheron-suite",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "comprueba": "node scripts/comprueba-contenido.mjs && node scripts/comprueba-jornadas.mjs",
    "prueba": "node scripts/prueba-minimo-publicable.mjs",
    "prueba-jornadas": "node --experimental-strip-types --no-warnings scripts/prueba-jornadas.mts",
    "redespliegue-necesario": "node scripts/necesita-redespliegue.mjs",
    "foto": "node scripts/optimiza-fotos.mjs",
    "prebuild": "node scripts/comprueba-contenido.mjs && node scripts/comprueba-jornadas.mjs && node scripts/optimiza-selector.mjs",
    "build": "astro build",
    "preview": "astro preview",
    "prueba-canario": "node --experimental-strip-types --no-warnings scripts/prueba-canario-endpoint.mts",
    "prueba-canario-seguridad": "node scripts/prueba-canario-seguridad.mjs"
  },
  "dependencies": {
    "@astrojs/vercel": "^11.0.11",
    "astro": "7.2.4"
  },
  "devDependencies": {
    "sharp": "^0.35.3"
  }
}
