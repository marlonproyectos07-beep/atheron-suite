---
/* ============================================================
   FOTO — muestra la imagen si existe, y si no el rectangulo rayado

   Es la pieza que convierte "foto pendiente" en una foto de verdad
   sin tocar ni una linea de codigo: en cuanto subes la imagen desde
   el panel, este componente la pinta.

   SIN IMAGEN NO PINTA NADA, Y ES DELIBERADO. Antes dibujaba un
   rectangulo rayado con el texto "Foto pendiente". Eso servia mientras
   el sitio era un borrador interno, pero al huesped le dice que la casa
   no esta terminada. Direccion lo retiro el 8 de septiembre de 2026: lo
   que falta se documenta dentro, no se le enseña al visitante. El
   <slot> se conserva en la firma para no romper las llamadas que ya
   pasan un texto, pero ese texto ya no se pinta.

   Sobre el texto alternativo (alt):
   es lo que lee un buscador y lo que oye alguien que usa lector de
   pantalla. No es opcional por capricho: una foto sin alt es una
   foto que Google no entiende. Si falta, avisamos en la consola
   durante el desarrollo en vez de dejarlo pasar en silencio.
   ============================================================ */

import { medidasDe } from '../data/medidas-imagen';

interface Props {
  /** Direccion de la imagen. Si no hay, se pinta el rectangulo. */
  src?: string;
  /** Que se ve en la foto, en una frase. */
  alt?: string;
  /** Forma: "alto", "ancho", "cuadrado" o nada para 4/3. */
  forma?: 'alto' | 'ancho' | 'cuadrado';
  /* --- Version responsive (opcional) ---
     Si se pasan "anchos", la foto sale dentro de un <picture> con
     AVIF y WebP en esos tamanos, y el src queda de respaldo. Los
     archivos tienen que existir con el sufijo del ancho, tal como
     los deja el mismo proceso que se uso en main:
       la-magia-de-zipaquira-principal-700.avif
     Sin "anchos", este componente se comporta exactamente igual
     que antes: un <img> y ya. */
  anchos?: number[];
  /** Que espacio ocupa la foto, para que el navegador elija tamano. */
  medidas?: string;
  /* Medidas reales del archivo, para reservar el hueco (evita CLS).
     Si no se pasan, se leen del propio archivo al construir: ver
     src/data/medidas-imagen.ts. Pasarlas a mano solo hace falta
     cuando la imagen se recorta y las del archivo no sirven. */
  ancho?: number;
  alto?: number;
  /* true = esta imagen es la que el visitante ve primero, sin
     desplazar la pagina. Se carga de inmediato y con prioridad
     alta, porque es la que Lighthouse mide como LCP.

     Solo puede haber UNA por pagina. Diferirla la retrasa; pero
     marcar varias tambien, porque compiten entre si y el navegador
     deja de saber cual importa. Por eso es una excepcion explicita
     y no el valor por defecto. */
  prioritaria?: boolean;
}

const { src, alt, forma, anchos, medidas, ancho, alto, prioritaria } = Astro.props;

/* Si quien llama no da las medidas, se leen del propio archivo. Es
   lo que reserva el hueco de la imagen antes de que baje y evita que
   la pagina de el salto (CLS). Un ancho o alto pasado a mano manda
   sobre esto: puede haber un recorte que el archivo no sabe. */
const propias = ancho && alto ? null : medidasDe(src);
const anchoFinal = ancho ?? propias?.ancho;
const altoFinal = alto ?? propias?.alto;

/* Carga: la prioritaria se pide ya; todas las demas esperan a estar
   cerca de la pantalla. Es la regla de rendimiento del sitio y vive
   aqui, en un solo sitio, y no repetida en cada maqueta. */
const carga = prioritaria ? 'eager' : 'lazy';
const prioridadRed = prioritaria ? 'high' : undefined;

/* Las variantes se nombran a partir del propio src: se le quita la
   extension y se le pega "-<ancho>.<formato>". Asi no hay una segunda
   lista de rutas que se pueda desincronizar con los archivos. */
const sinExtension = src ? src.replace(/\.[^.]+$/, '') : '';
const juego = (formato: string) =>
  (anchos ?? []).map((w) => `${sinExtension}-${w}.${formato} ${w}w`).join(', ');
/* Las fotos ya optimizadas del edificio aliado se cargan directamente.
   No tienen todavía el juego de derivados -240/-400/etc.; anunciar
   variantes inexistentes en <source> hace que el navegador elija un 404. */
const esFotoEdificioAlgarra = Boolean(src?.startsWith('/assets/edificio-algarra/'));
const hayVariantes = Boolean(src && anchos && anchos.length && !esFotoEdificioAlgarra);

const sufijo = forma ? `--${forma}` : '';
const claseFoto = `foto${sufijo ? ` foto${sufijo}` : ''}`;
const clasePlaceholder = `placeholder${sufijo ? ` placeholder${sufijo}` : ''}`;

if (src && !alt) {
  console.warn(
    `[Foto] La imagen ${src} no tiene texto alternativo. ` +
    `Rellena el campo "Que se ve en la foto" en el panel.`,
  );
}
---

{src && hayVariantes ? (
  <picture>
    <source type="image/avif" sizes={medidas} srcset={juego('avif')} />
    <source type="image/webp" sizes={medidas} srcset={juego('webp')} />
    <img
      class={claseFoto}
      src={src}
      alt={alt ?? ''}
      width={anchoFinal}
      height={altoFinal}
      loading={carga}
      fetchpriority={prioridadRed}
      decoding="async"
    />
  </picture>
) : src ? (
  <img
    class={claseFoto}
    src={src}
    alt={alt ?? ''}
    width={anchoFinal}
    height={altoFinal}
    loading={carga}
    fetchpriority={prioridadRed}
    decoding="async"
  />
) : null}
