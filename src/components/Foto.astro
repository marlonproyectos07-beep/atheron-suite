---
/* ============================================================
   FOTO — muestra la imagen si existe, y si no el rectangulo rayado

   Es la pieza que convierte "foto pendiente" en una foto de verdad
   sin tocar ni una linea de codigo: en cuanto subes la imagen desde
   el panel, este componente deja de pintar el rectangulo y pinta la
   foto. Las proporciones son las mismas, asi que el diseno no se
   mueve.

   Sobre el texto alternativo (alt):
   es lo que lee un buscador y lo que oye alguien que usa lector de
   pantalla. No es opcional por capricho: una foto sin alt es una
   foto que Google no entiende. Si falta, avisamos en la consola
   durante el desarrollo en vez de dejarlo pasar en silencio.
   ============================================================ */

interface Props {
  /** Direccion de la imagen. Si no hay, se pinta el rectangulo. */
  src?: string;
  /** Que se ve en la foto, en una frase. */
  alt?: string;
  /** Forma: "alto", "ancho", "cuadrado" o nada para 4/3. */
  forma?: 'alto' | 'ancho' | 'cuadrado';
  /* --- Version responsive (opcional) ---
     Si se pasan "anchos", la foto sale dentro de un <picture> con
     AVIF y WebP en esos tamanos, y el src queda de respaldo. Los
     archivos tienen que existir con el sufijo del ancho, tal como
     los deja el mismo proceso que se uso en main:
       la-magia-de-zipaquira-principal-700.avif
     Sin "anchos", este componente se comporta exactamente igual
     que antes: un <img> y ya. */
  anchos?: number[];
  /** Que espacio ocupa la foto, para que el navegador elija tamano. */
  medidas?: string;
  /** Medidas reales del archivo, para reservar el hueco (evita CLS). */
  ancho?: number;
  alto?: number;
}

const { src, alt, forma, anchos, medidas, ancho, alto } = Astro.props;

/* Las variantes se nombran a partir del propio src: se le quita la
   extension y se le pega "-<ancho>.<formato>". Asi no hay una segunda
   lista de rutas que se pueda desincronizar con los archivos. */
const sinExtension = src ? src.replace(/\.[^.]+$/, '') : '';
const juego = (formato: string) =>
  (anchos ?? []).map((w) => `${sinExtension}-${w}.${formato} ${w}w`).join(', ');
/* Las fotos ya optimizadas del edificio aliado se cargan directamente.
   No tienen todavía el juego de derivados -240/-400/etc.; anunciar
   variantes inexistentes en <source> hace que el navegador elija un 404. */
const esFotoEdificioAlgarra = Boolean(src?.startsWith('/assets/edificio-algarra/'));
const hayVariantes = Boolean(src && anchos && anchos.length && !esFotoEdificioAlgarra);

const sufijo = forma ? `--${forma}` : '';
const claseFoto = `foto${sufijo ? ` foto${sufijo}` : ''}`;
const clasePlaceholder = `placeholder${sufijo ? ` placeholder${sufijo}` : ''}`;

if (src && !alt) {
  console.warn(
    `[Foto] La imagen ${src} no tiene texto alternativo. ` +
    `Rellena el campo "Que se ve en la foto" en el panel.`,
  );
}
---

{src && hayVariantes ? (
  <picture>
    <source type="image/avif" sizes={medidas} srcset={juego('avif')} />
    <source type="image/webp" sizes={medidas} srcset={juego('webp')} />
    <img
      class={claseFoto}
      src={src}
      alt={alt ?? ''}
      width={ancho}
      height={alto}
      loading="lazy"
      decoding="async"
    />
  </picture>
) : src ? (
  <img
    class={claseFoto}
    src={src}
    alt={alt ?? ''}
    loading="lazy"
    decoding="async"
  />
) : (
  <div class={clasePlaceholder}><slot /></div>
)}
