---
/* ============================================================
   TARJETA DE UNA UNIDAD DEL PROYECTO

   Hotel, restaurante, cafeteria y gastrobar. Cada una se presenta
   con una frase y un boton que despliega su detalle.

   POR QUE EL DETALLE SE ABRE CON <details> Y NO CON UNA VENTANA

   Una ventana emergente hay que construirla entera: abrir, cerrar
   con Escape, atrapar el foco dentro, devolverlo al boton al salir
   y avisar al lector de pantalla. Todo eso con JavaScript, y con
   JavaScript que puede no cargar.

   <details> hace exactamente lo mismo sin una linea de guion: el
   navegador ya sabe abrirlo, cerrarlo, enfocarlo y anunciarlo. Es
   ademas la unica version que funciona si el visitante llega con
   el buscador del navegador (Ctrl+F encuentra el texto cerrado).

   NOMBRE DE LA CUARTA UNIDAD
   En pantalla pone "Gastrobar". El nombre administrativo,
   "Restaurante gastrobar", viaja en el atributo data-unidad y en
   los datos estructurados. Nunca "bar" a secas.

   POR QUE LA IMAGEN VA DENTRO DEL DESPLEGABLE Y NO EN LA TARJETA

   Tres razones, y ninguna es estetica. Las cuatro tarjetas comparten
   fila: si dos llevan imagen y dos no, la rejilla se descuadra y
   parece que a dos unidades les falta algo. Dentro del <details>
   la imagen no se descarga hasta que alguien lo abre, asi que
   cuatro representaciones conceptuales no cuestan nada al cargar
   la pagina. Y el rotulo obligatorio se lee junto a la imagen, en
   su contexto, en vez de suelto en un mosaico.

   Una unidad sin imagen propia no lleva un hueco: lleva un enlace
   al espacio del comparador donde ya se ensena. Es la diferencia
   entre "falta algo" y "esta en otra parte".
   ============================================================ */

import ProyectoEstado from './ProyectoEstado.astro';
import ProyectoFoto from './ProyectoFoto.astro';
import { fechaEnTexto } from '../data/casa-colonial-centro';
import type { Unidad } from '../data/casa-colonial-centro';

interface Props {
  unidad: Unidad;
}

const { unidad } = Astro.props;
---

<article class="unidad" id={`unidad-${unidad.id}`} data-unidad={unidad.nombreAdministrativo}>
  {/* Recurso visual: la inicial de la unidad, dibujada con CSS. No
      es una imagen, asi que no anade peticiones y nadie puede
      confundirla con una fotografia del sitio. Se oculta al lector
      de pantalla porque el titulo dice lo mismo, y mejor. */}
  <p class="unidad__icono" aria-hidden="true">{unidad.icono}</p>
  <h3 class="unidad__titulo">{unidad.titulo}</h3>
  <ProyectoEstado estado={unidad.estado} />
  <p class="unidad__texto">{unidad.texto}</p>

  <details class="unidad__detalle">
    <summary class="unidad__boton" data-evento={unidad.evento}>{unidad.ctaTexto}</summary>

    <div class="unidad__contenido">
      {unidad.titulo !== unidad.nombreAdministrativo && (
        <p class="unidad__nombre-formal texto-suave">
          Denominación en trámites y documentos: {unidad.nombreAdministrativo}.
        </p>
      )}

      {unidad.actualizado && (
        <p class="unidad__nombre-formal texto-suave">
          Actualizado el <time datetime={unidad.actualizado}>{fechaEnTexto(unidad.actualizado)}</time>.
        </p>
      )}

      {unidad.detalle ? (
        <p>{unidad.detalle}</p>
      ) : (
        <p class="texto-suave">
          La visión ampliada de esta unidad está en preparación. No se publican
          capacidades, tarifas, aforos ni fechas mientras no estén confirmadas.
        </p>
      )}

      {unidad.foto && (
        <ProyectoFoto
          foto={unidad.foto}
          clase="unidad__foto"
          medidas="(min-width: 900px) 20rem, 100vw"
        />
      )}

      {unidad.remiteA && (
        <p class="unidad__remite">
          <a href={unidad.remiteA.href}>{unidad.remiteA.texto}</a>
        </p>
      )}
    </div>
  </details>
</article>

