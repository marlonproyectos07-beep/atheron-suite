---
/* ============================================================
   PAGINA LEGAL — marco comun de las tres paginas legales

   Mientras BORRADOR_LEGAL sea true: noindex, nofollow y banda de
   borrador (la banda la pinta Base.astro con avisoBorrador).
   ============================================================ */
import Base from '../layouts/Base.astro';
import Cabecera from './Cabecera.astro';
import Pie from './Pie.astro';
import { menuBlog, ctaDisponibilidad } from '../data/navegacion';
import { BORRADOR_LEGAL, AVISO_BORRADOR_LEGAL, VERSION_LEGAL, VIGENCIA_LEGAL } from '../data/legal';

interface Props {
  titulo: string;
  descripcion: string;
  ruta: string;
}
const { titulo, descripcion, ruta } = Astro.props;
---

<Base
  titulo={`${titulo} | Atheron Suite`}
  descripcion={descripcion}
  ruta={ruta}
  indexable={!BORRADOR_LEGAL}
  seguirEnlaces={!BORRADOR_LEGAL ? true : false}
  avisoBorrador={BORRADOR_LEGAL ? AVISO_BORRADOR_LEGAL : null}
  hojasExtra={['legal']}
>
  <Cabecera enlaces={menuBlog} cta={{ ...ctaDisponibilidad, origen: 'legal' }} />

  <main id="contenido">
    <section class="seccion">
      <div class="contenedor legal">
        <h1>{titulo}</h1>
        <p class="legal__meta">
          Versión {VERSION_LEGAL}{VIGENCIA_LEGAL && <> · Vigente desde {VIGENCIA_LEGAL}</>}
        </p>
        <slot />
      </div>
    </section>
  </main>

  <Pie />
</Base>
