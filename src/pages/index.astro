  {/* ============================================================
       VIDEO DE FONDO DEL HERO — mejora progresiva

       Va en linea y no en un archivo de public/assets/js/ como el resto
       del sitio: es un kilobyte, y una peticion mas, aunque sea
       diferida, sigue siendo una peticion en la ruta que precisamente
       hay que proteger.

       Sin este guion la portada funciona exactamente igual que antes:
       el <video> se queda vacio e invisible y lo que se ve es la
       imagen. Ese es el criterio de que la mejora es progresiva de
       verdad y no un adorno que se cae con estilo.
       ============================================================ */}
  <script is:inline>
    (function () {
      var v = document.getElementById('video-portada');
      if (!v || typeof v.canPlayType !== 'function') return;

      /* 1. Movimiento reducido: no se pausa, no se descarga. */
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      /* 2. Ahorro de datos o conexion pobre: manda la imagen. */
      var con = navigator.connection || navigator.mozConnection || navigator.webkitConnection;
      var tipo = (con && con.effectiveType) || '';
      if (con && (con.saveData || /(^|-)(2g|slow-2g)$/.test(tipo))) return;

      /* 3. Ancho de pantalla. Decide CUAL video -el hero movil mide
            390 px y no necesita 1280 de ancho- y, de momento, tambien
            decide SI lo hay.

            INTERRUPTOR DEL EXPERIMENTO. El video en movil quedo
            construido y probado, pero desactivado por medida propia. Se
            aisló la causa ejecutando Lighthouse sobre ESTE MISMO codigo,
            bloqueando y permitiendo la descarga del video:

              video bloqueado : Speed Index 0,9-1,1 s   100 en 5 de 5
              video permitido : Speed Index 2,1-2,2 s   100 en 5 de 5

            El video multiplica por 2,4 el Speed Index. La puntuacion
            aguanta en 100 porque 2,2 s todavia entra en la banda, pero
            se queda sin margen: en siete pasadas anteriores una cayo a
            98 en cuanto se sumo un pico de CPU. La regla acordada dice
            revertir solo el video movil si peligra el 100, y eso es lo
            que esta pasando.

            Para habilitarlo basta poner esta constante en true; el resto
            del camino -eleccion de archivo, guardas y derivados de 960
            px- ya esta hecho y verificado. */
      var VIDEO_EN_MOVIL = false;

      var estrecha = !window.matchMedia('(min-width: 62rem)').matches;
      if (estrecha && !VIDEO_EN_MOVIL) return;

      /* 4. En pantalla estrecha el listón sube. Ahí el video se paga con
            datos moviles y bateria ajena, asi que solo entra cuando el
            terreno es claramente bueno: 3G no basta, y un telefono con
            poca memoria tampoco. Si el navegador no informa, se concede
            el beneficio de la duda: no se castiga por callar. */
      if (estrecha) {
        if (tipo && tipo !== '4g') return;
        if (typeof navigator.deviceMemory === 'number' && navigator.deviceMemory < 4) return;
      }

      /* 5. Compatibilidad real, preguntada al navegador. Si no puede con
            ninguno de los dos formatos, no se descarga nada. */
      var puedeWebm = !!v.canPlayType('video/webm; codecs="vp9"');
      var puedeMp4 = !!v.canPlayType('video/mp4; codecs="avc1.42E01E"');
      if (!puedeWebm && !puedeMp4) return;

      var base = '/assets/video/portada/zipaquira-plaza-dron' + (estrecha ? '-movil' : '');

      var iniciado = false;   /* la fuente ya esta puesta */
      var programado = false; /* alguien ya pidio el arranque */
      var reloj = null;

      /* Ni un temporizador ni un oyente sobreviven al arranque. */
      function suelta() {
        window.removeEventListener('load', programa);
        document.removeEventListener('DOMContentLoaded', desdeDom);
        if (reloj) { clearTimeout(reloj); reloj = null; }
      }

      function reproduce() {
        var p = v.play();
        if (p && typeof p.catch === 'function') {
          p.catch(function () {
            /* Reproduccion automatica denegada. No se hace nada: la
               imagen ya esta debajo y nadie nota que faltaba algo. */
          });
        }
      }

      /* La imagen de respaldo tiene que estar pintada antes de que el
         video toque la red. Si todavia no lo esta, no se marca nada como
         iniciado y se reintenta: el video no adelanta jamas al poster. */
      function posterListo() {
        var img = v.parentNode.querySelector('.hero__fondo img');
        return !img || (img.complete && img.naturalWidth > 0);
      }

      /* UNICO punto de entrada, y es idempotente: los dos caminos
         terminan aqui y solo el primero llega a hacer algo. */
      function inicia() {
        if (iniciado) return;

        /* Si el hero no se ve -el navegador puede restaurar la posicion
           de lectura al recargar- no se descarga nada todavia. No se
           marca como iniciado: el observador reintentara si el visitante
           sube. Marcarlo aqui gastaria el unico intento sin hacer nada. */
        var caja = v.getBoundingClientRect();
        if (caja.bottom <= 0 || caja.top >= (window.innerHeight || 0)) return;

        if (!posterListo()) { setTimeout(inicia, 400); return; }

        iniciado = true;
        suelta();

        /* Algunos navegadores exigen la propiedad, no solo el atributo,
           para permitir la reproduccion automatica. */
        v.muted = true;

        /* Se declaran los dos formatos y el navegador descarga UNO: el
           primero que sabe reproducir. Los <source> no compiten, se
           evaluan en orden. Y si ya sabemos que no puede con WebM, ni
           siquiera se le ofrece. */
        var fuentes = [];
        if (puedeWebm) fuentes.push([base + '.webm', 'video/webm']);
        if (puedeMp4) fuentes.push([base + '.mp4', 'video/mp4']);
        fuentes.forEach(function (par) {
          var s = document.createElement('source');
          s.src = par[0];
          s.type = par[1];
          v.appendChild(s);
        });

        /* Solo se muestra cuando hay imagen de verdad que mostrar. */
        v.addEventListener('playing', function () {
          v.setAttribute('data-visible', 'si');
        }, { once: true });

        v.load();
        reproduce();
      }

      /* Se cede el paso al hilo principal antes de tocar la red, para no
         competir nunca con el recurso LCP. */
      function programa() {
        if (programado || iniciado) return;
        programado = true;
        suelta();
        if (window.requestIdleCallback) {
          window.requestIdleCallback(inicia, { timeout: 3000 });
        } else {
          setTimeout(inicia, 300);
        }
      }

      /* Red de seguridad. "load" espera a TODOS los recursos, incluidos
         los de terceros: si una hoja externa se cuelga, load se retrasa
         y sin esto el video no arrancaria nunca. El margen se cuenta
         desde que el documento esta listo, muy por detras del LCP, asi
         que no adelanta ninguna descarga. Gana el que llegue primero y
         el otro camino se desactiva solo. */
      function desdeDom() {
        reloj = setTimeout(programa, 2500);
      }

      if (document.readyState === 'complete') {
        programa();
      } else {
        window.addEventListener('load', programa, { once: true });
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', desdeDom, { once: true });
        } else {
          desdeDom();
        }
      }

      /* Fuera de pantalla o pestaña de fondo, no se gasta bateria. Y si
         el hero no estaba a la vista cuando tocaba arrancar, este es el
         que lo reintenta. */
      if ('IntersectionObserver' in window) {
        new IntersectionObserver(function (entradas) {
          entradas.forEach(function (e) {
            if (!e.isIntersecting) { if (iniciado) v.pause(); return; }
            if (iniciado) reproduce();
            else if (programado) inicia();
          });
        }, { threshold: 0 }).observe(v);
      }

      document.addEventListener('visibilitychange', function () {
        if (!iniciado) return;
        if (document.hidden) v.pause();
        else reproduce();
      });
    })();
  </script>

