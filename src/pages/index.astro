---
/* ============================================================
   HOME de Atheron Suite
   Esta es la pagina principal: explica QUIEN es Atheron Suite
   y reparte el trafico hacia los hospedajes y el contacto.

   El <head> lo pone src/layouts/Base.astro.
   La cabecera y el pie son componentes compartidos.
   Aqui solo vive lo que es propio de la portada.
   ============================================================ */

import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Cabecera from '../components/Cabecera.astro';
import Pie from '../components/Pie.astro';
import BotonFlotante from '../components/BotonFlotante.astro';
import Marca from '../components/Marca.astro';
import Foto from '../components/Foto.astro';
import { menuHome, menuHomeMovil, ctaDisponibilidad } from '../data/navegacion';
import ContactoWhatsApp from '../components/ContactoWhatsApp.astro';
import { formularioContactoActivo } from '../data/ajustes';

/* Los cuatro hospedajes destacados salen de la misma coleccion que
   alimenta el listado y las fichas. Antes estaban escritos a mano
   aqui, y dos de las tres tarjetas enlazaban a la plantilla en vez
   de a su ficha: justo el tipo de descuadre que pasa cuando el
   mismo dato vive en tres sitios. */
const destacados = (await getCollection('hospedajes'))
  .filter((f) => f.data.publicado)
  .sort((a, b) => a.data.orden - b.data.orden)
  .slice(0, 4);

/* Ficha del negocio para Google y los asistentes de IA.

   Aqui NO ponemos direccion ni telefono todavia: no los tenemos
   confirmados. Solo se marca informacion que el visitante pueda
   ver en la pagina; marcar datos inventados es motivo de
   penalizacion. Se agregan cuando cierren los pendientes 8 y 22. */
const fichaNegocio = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Atheron Suite',
  description: 'Colección de hospedajes seleccionados en Zipaquirá, Cundinamarca.',
  url: 'https://hotelesatheron.com/',
  areaServed: {
    '@type': 'City',
    name: 'Zipaquirá',
    containedInPlace: {
      '@type': 'AdministrativeArea',
      name: 'Cundinamarca, Colombia',
    },
  },
};
---

<Base
  titulo="Atheron Suite | Hospedajes con alma en Zipaquirá, Cundinamarca"
  descripcion="Atheron Suite reúne hospedajes seleccionados en Zipaquirá, Cundinamarca. Estancias cómodas a minutos de la Catedral de Sal y del centro histórico."
  ruta="/"
  ogTitulo="Atheron Suite | Hospedajes en Zipaquirá, Cundinamarca"
  ogDescripcion="Hospedajes seleccionados en Zipaquirá, a minutos de la Catedral de Sal y del centro histórico."
  jsonLd={fichaNegocio}
  avisoBorrador="Version de trabajo. Faltan fotografias en algunas secciones."
  hojasExtra={['portada']}
>

  <Cabecera enlaces={menuHome} enlacesMovil={menuHomeMovil} cta={ctaDisponibilidad} actual="/" />

  <main id="contenido">

    {/* ============================================================
         1. HERO — promesa principal en 5 segundos
         ============================================================ */}
    <section class="hero hero--portada">

      {/* Activo generado con inteligencia artificial: recreacion visual
          conceptual de Zipaquira, no fotografia documental. Registro en
          docs/fotografias.md. Por eso es decorativa, sin texto
          alternativo y oculta a los lectores de pantalla: lo que dice la
          portada esta en el H1 y en el parrafo, y asi no se afirma en
          ningun sitio que sea una toma real. Se carga con prioridad alta
          y sin diferir, porque es el elemento LCP; las medidas van
          declaradas para que no desplace nada.

          Fase 2 previstas: este <picture> pasara a ser el poster y el
          fallback del video de fondo, y seguira siendo el LCP. El
          contrato esta en docs/propuesta-multiidioma-y-video.md, B.6. */}
      <picture class="hero__fondo" aria-hidden="true">
        <source media="(max-width: 700px)" type="image/avif" srcset="/assets/img/portada/zipaquira-centro-historico-atardecer-700.avif" />
        <source media="(max-width: 700px)" type="image/webp" srcset="/assets/img/portada/zipaquira-centro-historico-atardecer-700.webp" />
        <source type="image/avif" srcset="/assets/img/portada/zipaquira-centro-historico-atardecer-1600.avif" />
        <img
          src="/assets/img/portada/zipaquira-centro-historico-atardecer-1600.webp"
          alt=""
          width="1600"
          height="837"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </picture>

      {/* Video de fondo. Nace SIN fuente y SIN autoplay, a proposito: con
          autoplay el navegador antepone la intencion de reproducir a
          preload="none" y empieza a descargar durante la carga inicial,
          que es justo el momento que hay que proteger. La fuente se la
          adjunta el guion de abajo cuando ya no puede estorbar. */}
      <video
        id="video-portada"
        class="hero__video"
        muted
        loop
        playsinline
        preload="none"
        aria-hidden="true"
        tabindex="-1"
        width="1280"
        height="720"
      ></video>

      <div class="contenedor hero__contenido">

        <span class="hero__etiqueta">Zipaquirá · Cerca de la Catedral de Sal</span>

        <h1 class="hero__titulo">Hospédate en Zipaquirá</h1>

        {/* El precio es texto visible y nada mas. No entra en JSON-LD:
            declararlo como oferta estructurada obligaria a sostener
            condiciones, vigencia y disponibilidad que no tenemos.

            "Tarifa de referencia" y no una cifra a secas: un grupo de
            diez multiplica mentalmente por diez, le sale seiscientos
            cincuenta mil y se va antes de enterarse de que existe otra
            tarifa. La linea de grupos va pegada al precio, no tres
            bloques mas abajo, porque ahi es donde se toma esa decision. */}
        <p class="hero__precio">
          <span class="hero__precio-rotulo">Tarifa de referencia</span>
          <span class="hero__precio-cifra"><strong>$65.000</strong> por persona</span>
        </p>

        <p class="hero__grupos">
          ¿Viajan en grupo? Cotizamos una tarifa especial.
        </p>

        <p class="hero__texto">
          Casas y habitaciones para parejas, familias y grupos.
        </p>

        <div class="grupo-botones">
          <a class="boton boton--acento boton--grande" href="/hospedajes">
            Ver hospedajes
          </a>
          {/* El mensaje va escrito: cotizar no deberia obligar a redactar.
              El href es el respaldo si main.js no carga. */}
          <a
            class="boton boton--claro boton--grande"
            href="#contacto"
            data-whatsapp="Hola, Atheron. Somos un grupo y quisiera cotizar hospedaje en Zipaquirá."
          >
            Cotizar mi grupo
          </a>
        </div>

        {/* Datos rapidos: dan confianza sin pedir nada a cambio. En movil
            se ocultan, que es donde el alto de pantalla es el problema. */}
        <div class="hero__datos">
          <div class="dato">
            <span class="dato__numero">7</span>
            <span class="dato__texto">Hospedajes</span>
          </div>
          <div class="dato">
            <span class="dato__numero">1</span>
            <span class="dato__texto">Ciudad: Zipaquirá</span>
          </div>
          <div class="dato">
            <span class="dato__numero">~50 km</span>
            <span class="dato__texto">Desde Bogotá</span>
          </div>
        </div>

      </div>
    </section>


    {/* ============================================================
         1.bis QUE HAY — tipos y para quien

         Compacta a proposito. El hero ya se recorto para que se vea la
         fotografia; volver a llenarlo aqui seria deshacerlo.

         Los cuatro tipos salen de las fichas publicadas: casa entera
         (Algarra), campestre (Neusa), apartamentos con cocina (Atheron
         Suite) y habitaciones privadas (Colonial Confort). No se afirma
         Wi-Fi de forma global porque no hay medicion que lo respalde en
         las cuatro, y la cocina se dice donde consta.
         ============================================================ */}
    <div class="contenedor">
      <ul class="oferta">
        <li class="oferta__tipo"><strong>Habitaciones</strong></li>
        <li class="oferta__tipo"><strong>Apartamentos</strong> con cocina</li>
        <li class="oferta__tipo"><strong>Casas completas</strong></li>
        <li class="oferta__tipo"><strong>Casa campestre</strong></li>
      </ul>
      <p class="oferta__para">Para parejas, familias y grupos.</p>
    </div>


    {/* ============================================================
         2. FRANJA DE CONFIANZA
         ============================================================ */}
    <div class="contenedor">
      <div class="franja">
        <div class="franja__item">
          <strong>Atención directa</strong>
          <span>Hablas con el anfitrion, sin intermediarios</span>
        </div>
        <div class="franja__item">
          <strong>Ubicaciones elegidas</strong>
          <span>Cerca del centro histórico y de la Catedral de Sal</span>
        </div>
        <div class="franja__item">
          <strong>Espacios verificados</strong>
          <span>Revisamos cada hospedaje antes de publicarlo</span>
        </div>
        <div class="franja__item">
          <strong>Trato local</strong>
          <span>Recomendaciones de quien vive Zipaquirá</span>
        </div>
      </div>
    </div>


    {/* ============================================================
         3. QUE ES ATHERON SUITE
         ============================================================ */}
    <section class="seccion">
      <div class="contenedor bloque-doble aparecer">

        <div class="bloque-doble__texto">
          <span class="etiqueta">Quienes somos</span>
          <h2>Una colección, no un directorio</h2>
          <p class="texto-grande texto-suave" style="margin-block: var(--esp-2) var(--esp-3);">
            Atheron Suite nace en Zipaquirá con hospedajes seleccionados uno por uno.
            No listamos todo lo que existe: mostramos los lugares donde nosotros mismos
            nos quedariamos.
          </p>
          <ul class="lista-check">
            <li>Cada hospedaje tiene su propia pagina con fotos, habitaciones y ubicación.</li>
            <li>Precios y condiciones claros, sin sorpresas al final.</li>
            <li>Un solo canal de contacto para resolver dudas antes de decidir.</li>
          </ul>
        </div>

      </div>
    </section>


    {/* ============================================================
         3.bis COMO NACIO ATHERON SUITE
         Version corta. La larga vive en el blog.

         Por que esta seccion existe y no es relleno:
         - Da contexto real que ninguna plataforma de reserva ofrece
         - Introduce de forma natural terminos que queremos posicionar
           (turismo en Zipaquira, Catedral de Sal, casas para grupos)
         - Diferencia: Booking lista propiedades, no cuenta historias
         ============================================================ */}
    <section class="seccion seccion--oscura" id="historia">
      <div class="contenedor bloque-doble aparecer">

        <div class="bloque-doble__texto">
          <span class="etiqueta">Nuestra historia</span>
          <h2>Como nació Atheron Suite</h2>

          <p class="texto-grande texto-suave" style="margin-block: var(--esp-2) var(--esp-3);">
            Todo empezo con un problema que vimos de cerca. Llegaron cerca de mil
            turistas de China a conocer la Catedral de Sal, y Zipaquirá no tenia
            como recibirlos: faltaba alojamiento y faltaban servicios.
          </p>

          <p class="texto-suave" style="margin-bottom: var(--esp-3);">
            Ahi entendimos dos cosas. Que el turismo en Zipaquirá crecia mas
            rapido que su capacidad de atenderlo, y que buena parte del valor que
            ese turismo genera se estaba yendo de la region.
          </p>

          <p class="texto-suave" style="margin-bottom: var(--esp-3);">
            Todo comenzó con una habitación: la Suite 301. Despues fueron
            naciendo otras habitaciones, otras propiedades y las alianzas que hoy
            nos permiten recibir grupos. Cada una se levanto aprendiendo del
            huésped anterior y con lo que ese mismo trabajo iba dejando.
          </p>

          <p class="texto-suave" style="margin-bottom: var(--esp-3);">
            Hoy recibimos familias, viajeros y grupos grandes en Zipaquirá. Pero
            Atheron Suite no es solo alojamiento: es nuestra prueba piloto.
            Queremos demostrar aquí que se puede combinar hospitalidad,
            tecnologia y automatizacion para construir mejores destinos, y
            después llevar ese modelo a otras ciudades.
          </p>

          <p style="font-family: var(--fuente-titulo); font-size: 1.35rem; color: var(--color-sal-claro); margin-bottom: var(--esp-3);">
            Empezamos pequenos, pero pensamos en grande.
          </p>

          <div class="grupo-botones">
            <a class="boton boton--acento" href="/blog/como-nacio-atheron-suite">
              Leer la historia completa
            </a>
            <a class="boton boton--claro" href="/hospedajes">
              Conocer los hospedajes
            </a>
          </div>
        </div>

        {/* La primera habitación, la que empezo todo. Es la fotografia
            que le corresponde al texto: no un paisaje generico. */}
        <div class="bloque-doble__media">
          <Foto
            src="/assets/img/hospedajes/la-magia-de-zipaquira-301-camas.jpg"
            alt="Suite 301, la primera habitación de Atheron en Zipaquirá, con cama doble y camarote"
          />
        </div>

      </div>
    </section>


    {/* ============================================================
         4. HOSPEDAJES DESTACADOS
         Aqui mostramos hasta 4; el listado completo vive en /hospedajes
         ============================================================ */}
    <section class="seccion seccion--alterna" id="hospedajes">
      <div class="contenedor">

        <div class="encabezado-seccion encabezado-seccion--centrado aparecer">
          <span class="etiqueta">Nuestros hospedajes</span>
          <h2>Hospedajes para descubrir Zipaquirá</h2>
        </div>

        <div class="grid grid--4 aparecer">

          {destacados.map(({ id, data }) => {
            const enObra = !data.publicado;
            return (
              <article class="tarjeta">
                <div class="tarjeta__media">
                  <a
                    class="tarjeta__imagen-enlace"
                    href={`/hospedajes/${id}`}
                    aria-label={`Explorar ${data.nombre}`}
                  >
                    <Foto src={data.fotoTarjeta} alt={data.fotoTarjetaAlt}>Foto pendiente</Foto>
                  </a>
                  <span class="tarjeta__insignia">Hospedaje {data.insignia}</span>
                </div>
                <div class="tarjeta__cuerpo">
                  <h3 class="tarjeta__titulo">
                    <a href={`/hospedajes/${id}`}><Marca texto={data.nombre} pendiente={enObra} /></a>
                  </h3>
                  <p class="tarjeta__meta">
                    <span><Marca texto={data.listadoSector} pendiente={enObra} /></span>
                    <span><Marca texto={data.listadoSegundoDato} pendiente={enObra} />{data.listadoSegundoDatoSufijo}</span>
                  </p>
                  <p class="texto-suave">
                    <Marca texto={data.resumen} pendiente={enObra} />
                  </p>
                  <div class="tarjeta__pie">
                    {!data.precioPendiente && (
                    <span class="tarjeta__precio">
                      {data.precio} <span>/ noche</span>
                    </span>
                    )}
                    <a class="boton boton--contorno" href={`/hospedajes/${id}`}>Ver ficha</a>
                  </div>
                </div>
              </article>
            );
          })}

        </div>
        <div class="grupo-botones grupo-botones--centrado" style="margin-top: var(--esp-4);">
          <a class="boton boton--primario boton--grande" href="/hospedajes">
            Ver los hospedajes
          </a>
        </div>

      </div>
    </section>


    {/* ============================================================
         4.bis PROYECTOS ATHERON — CASA COLONIAL CENTRO

         Va en su PROPIA seccion y no mezclada entre los hospedajes,
         a proposito: lo que se puede reservar hoy y lo que todavia
         es un proyecto no pueden compartir rejilla, o el visitante
         intentara reservar algo que no existe.

         El enlace lleva rel="nofollow" y la pagina sigue en noindex.
         Que se pueda descubrir navegando no es lo mismo que pedirle
         a Google que la indexe.
         ============================================================ */}
    <section class="seccion" id="proyectos">
      <div class="contenedor">
        <span class="etiqueta">Próximamente · Proyectos Atheron</span>
        <h2>Casa Colonial Centro</h2>

        <p class="texto-grande texto-suave" style="max-width: 60ch; margin-block: var(--esp-2) var(--esp-2);">
          Un nuevo proyecto en el corazón de Zipaquirá.
        </p>

        <p class="texto-suave" style="max-width: 62ch; margin-bottom: var(--esp-3);">
          Una casa colonial en transformación para integrar alojamiento,
          gastronomía, experiencias y encuentros en el centro de Zipaquirá.
        </p>

        <p class="tarjeta__meta" style="margin-bottom: var(--esp-3);">
          <span>Hotel</span><span>Restaurante</span><span>Cafetería</span>
          <span>Gastrobar</span><span>Eventos</span>
        </p>

        <div class="grupo-botones">
          <a
            class="boton boton--contorno boton--grande"
            href="/proyectos/casa-colonial-centro"
            rel="nofollow"
          >
            Conocer el proyecto
          </a>
        </div>
      </div>
    </section>


    {/* ============================================================
         5. EXPERIENCIAS
         ============================================================ */}
    <section class="seccion" id="experiencias">
      <div class="contenedor">

        <div class="encabezado-seccion aparecer">
          <span class="etiqueta">Experiencias</span>
          <h2>Que hacer mientras te quedas con nosotros</h2>
        </div>

        <div class="grid grid--3 aparecer">

          <article class="experiencia">
            <div class="experiencia__fondo"></div>
            <div class="experiencia__texto">
              <h3>Catedral de Sal</h3>
              <p>El recorrido subterraneo mas conocido de Zipaquirá, a pocos minutos del centro.</p>
            </div>
          </article>

          <article class="experiencia">
            <div class="experiencia__fondo"></div>
            <div class="experiencia__texto">
              <h3>Centro histórico</h3>
              <p>Plaza principal, catedral diocesana, cafes y calles coloniales para caminar sin prisa.</p>
            </div>
          </article>

        </div>
      </div>
    </section>


    {/* ============================================================
         6. ZIPAQUIRA (el destino tambien vende)
         ============================================================ */}
    <section class="seccion seccion--alterna" id="zipaquira">
      <div class="contenedor bloque-doble bloque-doble--invertido aparecer">

        <div class="bloque-doble__texto">
          <span class="etiqueta">El destino</span>
          <h2>Zipaquirá, cerca de todo y lejos del ruido</h2>
          <p class="texto-suave" style="margin-block: var(--esp-2) var(--esp-3);">
            A unos 50 km al norte de Bogotá, Zipaquirá combina patrimonio, clima frio
            de sabana y una escala amable para caminar. Es un destino de fin de semana
            y también una base tranquila para trabajar unos dias.
          </p>

          <ul class="lista-distancias">
            <li><span>Desde Bogotá</span> <span>~50 km</span></li>
          </ul>
        </div>

      </div>
    </section>


    {/* ============================================================
         7. CONTACTO
         ============================================================ */}
    <section class="seccion" id="contacto">
      <div class="contenedor bloque-doble aparecer">

        <div class="bloque-doble__texto">
          <span class="etiqueta">Contacto</span>
          <h2>Cuentanos que fecha tienes en mente</h2>
          <p class="texto-suave" style="margin-block: var(--esp-2) var(--esp-3);">
            Respondemos con opciones concretas segun el numero de personas
            y los dias que necesites.
          </p>

          <ul class="lista-check">
            <li>Telefono / WhatsApp: <a href="tel:+573188983167">+57 318 898 3167</a></li>
            <li>Zipaquirá, Cundinamarca, Colombia</li>
          </ul>
        </div>

        <div class="bloque-doble__media">
          {formularioContactoActivo ? (
          <form class="formulario" data-formulario-contacto novalidate>

            <div class="formulario__fila">
              <div class="campo">
                <label for="nombre">Nombre</label>
                <input type="text" id="nombre" name="nombre" required autocomplete="name" />
              </div>
              <div class="campo">
                <label for="telefono">Teléfono</label>
                <input type="tel" id="telefono" name="telefono" autocomplete="tel" />
              </div>
            </div>

            <div class="campo">
              <label for="correo">Correo electronico</label>
              <input type="email" id="correo" name="correo" required autocomplete="email" />
            </div>

            <div class="formulario__fila">
              <div class="campo">
                <label for="llegada">Fecha de llegada</label>
                <input type="date" id="llegada" name="llegada" />
              </div>
              <div class="campo">
                <label for="personas">Personas</label>
                <select id="personas" name="personas">
                  <option value="1">1</option>
                  <option value="2" selected>2</option>
                  <option value="3">3</option>
                  <option value="4">4</option>
                  <option value="5+">5 o mas</option>
                </select>
              </div>
            </div>

            <div class="campo">
              <label for="mensaje">Mensaje</label>
              <textarea id="mensaje" name="mensaje" placeholder="Cuentanos que buscas..."></textarea>
            </div>

            <button class="boton boton--primario boton--grande" type="submit">
              Enviar consulta
            </button>

            <div class="aviso-formulario" data-aviso-formulario role="status"></div>

          </form>
          ) : (
            <ContactoWhatsApp mensaje="Hola, quiero información sobre los hospedajes de Atheron Suite en Zipaquirá." />
          )}
        </div>

      </div>
    </section>


    {/* ============================================================
         8. LLAMADO A LA ACCION FINAL
         ============================================================ */}
    <section class="seccion">
      <div class="contenedor">
        <div class="cta-final aparecer">
          <h2>Tu próxima escapada empieza aquí</h2>
          <p>
            Escribenos y te ayudamos a elegir que hospedaje se adapta mejor a tu viaje.
          </p>
          <div class="grupo-botones grupo-botones--centrado">
            <a class="boton boton--acento boton--grande" href="/landing/hospedaje-en-zipaquira">
              Ver la oferta de hospedaje
            </a>
            <a class="boton boton--claro boton--grande" href="#contacto">Escribirnos</a>
          </div>
        </div>
      </div>
    </section>

  </main>

  <Pie variante="completo" />

  <BotonFlotante
    href="#contacto"
    mensaje="Hola, quiero información sobre los hospedajes de Atheron Suite en Zipaquirá."
  />


  {/* ============================================================
       VIDEO DE FONDO DEL HERO — mejora progresiva

       Va en linea y no en un archivo de public/assets/js/ como el resto
       del sitio: es un kilobyte, y una peticion mas, aunque sea
       diferida, sigue siendo una peticion en la ruta que precisamente
       hay que proteger.

       Sin este guion la portada funciona exactamente igual que antes:
       el <video> se queda vacio e invisible y lo que se ve es la
       imagen. Ese es el criterio de que la mejora es progresiva de
       verdad y no un adorno que se cae con estilo.
       ============================================================ */}
  <script is:inline>
    (function () {
      var v = document.getElementById('video-portada');
      if (!v || typeof v.canPlayType !== 'function') return;

      /* 1. Movimiento reducido: no se pausa, no se descarga. */
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      /* 2. Ahorro de datos o conexion pobre: manda la imagen. */
      var con = navigator.connection || navigator.mozConnection || navigator.webkitConnection;
      var tipo = (con && con.effectiveType) || '';
      if (con && (con.saveData || /(^|-)(2g|slow-2g)$/.test(tipo))) return;

      /* 3. Ancho de pantalla. Decide CUAL video -el hero movil mide
            390 px y no necesita 1280 de ancho- y, de momento, tambien
            decide SI lo hay.

            INTERRUPTOR DEL EXPERIMENTO. El video en movil quedo
            construido y probado, pero desactivado por medida propia. Se
            aisló la causa ejecutando Lighthouse sobre ESTE MISMO codigo,
            bloqueando y permitiendo la descarga del video:

              video bloqueado : Speed Index 0,9-1,1 s   100 en 5 de 5
              video permitido : Speed Index 2,1-2,2 s   100 en 5 de 5

            El video multiplica por 2,4 el Speed Index. La puntuacion
            aguanta en 100 porque 2,2 s todavia entra en la banda, pero
            se queda sin margen: en siete pasadas anteriores una cayo a
            98 en cuanto se sumo un pico de CPU. La regla acordada dice
            revertir solo el video movil si peligra el 100, y eso es lo
            que esta pasando.

            Para habilitarlo basta poner esta constante en true; el resto
            del camino -eleccion de archivo, guardas y derivados de 960
            px- ya esta hecho y verificado. */
      var VIDEO_EN_MOVIL = false;

      var estrecha = !window.matchMedia('(min-width: 62rem)').matches;
      if (estrecha && !VIDEO_EN_MOVIL) return;

      /* 4. En pantalla estrecha el listón sube. Ahí el video se paga con
            datos moviles y bateria ajena, asi que solo entra cuando el
            terreno es claramente bueno: 3G no basta, y un telefono con
            poca memoria tampoco. Si el navegador no informa, se concede
            el beneficio de la duda: no se castiga por callar. */
      if (estrecha) {
        if (tipo && tipo !== '4g') return;
        if (typeof navigator.deviceMemory === 'number' && navigator.deviceMemory < 4) return;
      }

      /* 5. Compatibilidad real, preguntada al navegador. Si no puede con
            ninguno de los dos formatos, no se descarga nada. */
      var puedeWebm = !!v.canPlayType('video/webm; codecs="vp9"');
      var puedeMp4 = !!v.canPlayType('video/mp4; codecs="avc1.42E01E"');
      if (!puedeWebm && !puedeMp4) return;

      var base = '/assets/video/portada/zipaquira-plaza-dron' + (estrecha ? '-movil' : '');

      var iniciado = false;   /* la fuente ya esta puesta */
      var programado = false; /* alguien ya pidio el arranque */
      var reloj = null;

      /* Ni un temporizador ni un oyente sobreviven al arranque. */
      function suelta() {
        window.removeEventListener('load', programa);
        document.removeEventListener('DOMContentLoaded', desdeDom);
        if (reloj) { clearTimeout(reloj); reloj = null; }
      }

      function reproduce() {
        var p = v.play();
        if (p && typeof p.catch === 'function') {
          p.catch(function () {
            /* Reproduccion automatica denegada. No se hace nada: la
               imagen ya esta debajo y nadie nota que faltaba algo. */
          });
        }
      }

      /* La imagen de respaldo tiene que estar pintada antes de que el
         video toque la red. Si todavia no lo esta, no se marca nada como
         iniciado y se reintenta: el video no adelanta jamas al poster. */
      function posterListo() {
        var img = v.parentNode.querySelector('.hero__fondo img');
        return !img || (img.complete && img.naturalWidth > 0);
      }

      /* UNICO punto de entrada, y es idempotente: los dos caminos
         terminan aqui y solo el primero llega a hacer algo. */
      function inicia() {
        if (iniciado) return;

        /* Si el hero no se ve -el navegador puede restaurar la posicion
           de lectura al recargar- no se descarga nada todavia. No se
           marca como iniciado: el observador reintentara si el visitante
           sube. Marcarlo aqui gastaria el unico intento sin hacer nada. */
        var caja = v.getBoundingClientRect();
        if (caja.bottom <= 0 || caja.top >= (window.innerHeight || 0)) return;

        if (!posterListo()) { setTimeout(inicia, 400); return; }

        iniciado = true;
        suelta();

        /* Algunos navegadores exigen la propiedad, no solo el atributo,
           para permitir la reproduccion automatica. */
        v.muted = true;

        /* Se declaran los dos formatos y el navegador descarga UNO: el
           primero que sabe reproducir. Los <source> no compiten, se
           evaluan en orden. Y si ya sabemos que no puede con WebM, ni
           siquiera se le ofrece. */
        var fuentes = [];
        if (puedeWebm) fuentes.push([base + '.webm', 'video/webm']);
        if (puedeMp4) fuentes.push([base + '.mp4', 'video/mp4']);
        fuentes.forEach(function (par) {
          var s = document.createElement('source');
          s.src = par[0];
          s.type = par[1];
          v.appendChild(s);
        });

        /* Solo se muestra cuando hay imagen de verdad que mostrar. */
        v.addEventListener('playing', function () {
          v.setAttribute('data-visible', 'si');
        }, { once: true });

        v.load();
        reproduce();
      }

      /* Se cede el paso al hilo principal antes de tocar la red, para no
         competir nunca con el recurso LCP. */
      function programa() {
        if (programado || iniciado) return;
        programado = true;
        suelta();
        if (window.requestIdleCallback) {
          window.requestIdleCallback(inicia, { timeout: 3000 });
        } else {
          setTimeout(inicia, 300);
        }
      }

      /* Red de seguridad. "load" espera a TODOS los recursos, incluidos
         los de terceros: si una hoja externa se cuelga, load se retrasa
         y sin esto el video no arrancaria nunca. El margen se cuenta
         desde que el documento esta listo, muy por detras del LCP, asi
         que no adelanta ninguna descarga. Gana el que llegue primero y
         el otro camino se desactiva solo. */
      function desdeDom() {
        reloj = setTimeout(programa, 2500);
      }

      if (document.readyState === 'complete') {
        programa();
      } else {
        window.addEventListener('load', programa, { once: true });
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', desdeDom, { once: true });
        } else {
          desdeDom();
        }
      }

      /* Fuera de pantalla o pestaña de fondo, no se gasta bateria. Y si
         el hero no estaba a la vista cuando tocaba arrancar, este es el
         que lo reintenta. */
      if ('IntersectionObserver' in window) {
        new IntersectionObserver(function (entradas) {
          entradas.forEach(function (e) {
            if (!e.isIntersecting) { if (iniciado) v.pause(); return; }
            if (iniciado) reproduce();
            else if (programado) inicia();
          });
        }, { threshold: 0 }).observe(v);
      }

      document.addEventListener('visibilitychange', function () {
        if (!iniciado) return;
        if (document.hidden) v.pause();
        else reproduce();
      });
    })();
  </script>

