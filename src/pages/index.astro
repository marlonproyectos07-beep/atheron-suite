                  {/* Se pinta como texto y no como <a>: la tarjeta
                      entera ya es el enlace, y un enlace dentro de otro
                      no es HTML valido ni se puede tabular bien. */}
                  {e.ruta && (
                    <span class="experiencia__accion">
                      {e.enlaceTexto ?? `Ver ${e.titulo}`}
                    </span>
                  )}
                </div>
              </Envoltorio>
            );
          })}
        </div>

