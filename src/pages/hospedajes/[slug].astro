---
/* ============================================================
   FICHA DE HOSPEDAJE — UNA plantilla para los siete

   Los corchetes del nombre del archivo, [slug], significan
   "esta parte de la direccion es variable". Astro recorre la
   coleccion de hospedajes y genera una pagina por cada uno:

     src/content/hospedajes/hotel-atheron-suite.md
        -> /hospedajes/hotel-atheron-suite

   Antes esto eran 8 archivos HTML de 416 lineas cada uno, casi
   identicos. Cambiar una coma en el formulario obligaba a
   editarlos los ocho.

   LA DIRECCION LA MANDA EL NOMBRE DEL ARCHIVO .md
   Cuando llegue el nombre real del hospedaje 02, se renombra el
   archivo de contenido a, por ejemplo, casa-del-portal.md y la
   direccion pasa a ser /hospedajes/casa-del-portal. La canonica,
   el sitemap y los enlaces del listado se actualizan solos.
   Conviene hacerlo AHORA que las seis fichas estan en noindex y
   fuera del sitemap: Google no las tiene, asi que no hace falta
   montar ninguna redireccion.
   ============================================================ */

import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Cabecera from '../../components/Cabecera.astro';
import Pie from '../../components/Pie.astro';
import BotonFlotante from '../../components/BotonFlotante.astro';
import Marca from '../../components/Marca.astro';
import Foto from '../../components/Foto.astro';
import { menuFicha, menuFichaMovil, ctaConsultar } from '../../data/navegacion';
import ContactoWhatsApp from '../../components/ContactoWhatsApp.astro';
import { formularioContactoActivo } from '../../data/ajustes';

export async function getStaticPaths() {
  const fichas = await getCollection('hospedajes');
  return fichas.map((ficha) => ({
    params: { slug: ficha.id },
    props: { ficha },
  }));
}

const { ficha } = Astro.props;
const d = ficha.data;
const ruta = `/hospedajes/${ficha.id}`;

/* ------------------------------------------------------------
   QUE SECCIONES TIENEN DATOS DE VERDAD

   Regla del proyecto: si un dato todavia no existe, se oculta el
   bloque entero. Nunca se muestra "$ ---", "N huespedes" ni
   "Descripcion pendiente" a un cliente.

   Las anclas del menu de celular se filtran en consecuencia, para
   que no queden enlaces que no llevan a ninguna parte.
   ------------------------------------------------------------ */
const hayHabitaciones = d.habitaciones.some((h) => !h.pendiente);
const hayGaleria = d.galeria.length > 0;
/* Coordenadas ya listas para meter en una direccion. Vacio si la ficha
   no las tiene: entonces no salen los botones de "como llegar". */
const coordenadas =
  d.latitud != null && d.longitud != null ? `${d.latitud}%2C${d.longitud}` : '';
const experiencias = d.experiencias.filter((e) => !e.pendiente);

const enlacesMovil = menuFichaMovil.filter((e) => {
  if (e.href === '#habitaciones') return hayHabitaciones;
  if (e.href === '#galeria') return hayGaleria;
  return true;
});

/* El cuerpo del archivo .md es la descripcion larga del hospedaje. */
const { Content } = await render(ficha);

/* ============================================================
   DATOS ESTRUCTURADOS
   Se construyen a partir del contenido, no a mano.

   REGLA: solo se marca informacion que el visitante pueda ver en
   la pagina. Por eso cada campo se anade solo si existe:
   - "calle" solo en los hospedajes propios. En los aliados NO se
     publica la direccion exacta, ni en pantalla ni aqui.
   - "geo" solo cuando tengamos las coordenadas (pendiente 8).
   ============================================================ */
const fichaNegocio: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'LodgingBusiness',
  name: d.nombre,
  description: d.descripcion,
  url: `https://hotelesatheron.com${ruta}`,
  telephone: '+573188983167',
  address: {
    '@type': 'PostalAddress',
    ...(d.calle ? { streetAddress: d.calle } : {}),
    addressLocality: 'Zipaquira',
    addressRegion: 'Cundinamarca',
    addressCountry: 'CO',
  },
};

/* El nombre anterior solo se marca porque la pagina lo dice: va en
   descripcionZona, a la vista. Marcar lo que no se ve es motivo de
   penalizacion. */
if (d.nombreAnterior) fichaNegocio.alternateName = d.nombreAnterior;
/* Mientras no haya coordenadas, esta es la referencia buena de donde
   esta el hospedaje. */
if (d.enlaceMapa) fichaNegocio.hasMap = d.enlaceMapa;

if (d.latitud != null && d.longitud != null) {
  fichaNegocio.geo = {
    '@type': 'GeoCoordinates',
    latitude: d.latitud,
    longitude: d.longitud,
  };
}
if (d.mascotas !== undefined) fichaNegocio.petsAllowed = d.mascotas;
if (d.checkin) fichaNegocio.checkinTime = d.checkin;
if (d.checkout) fichaNegocio.checkoutTime = d.checkout;
if (d.comodidades.length) {
  fichaNegocio.amenityFeature = d.comodidades.map((nombre) => ({
    '@type': 'LocationFeatureSpecification',
    name: nombre,
    value: true,
  }));
}
fichaNegocio.parentOrganization = {
  '@type': 'Organization',
  name: 'Atheron Suite',
  url: 'https://hotelesatheron.com/',
};
/* Los datos de una habitacion admiten un numero ("3") o un texto entero
   ("1 cama doble con cama nido debajo, 1 camarote y 1 sofa cama"). Antes la
   plantilla pegaba la palabra siempre, y salia "1 banos" o "...sofa cama
   camas". Ahora solo la anade si el propio valor no la dice ya. */
function dato(valor, singular, plural) {
  const v = String(valor ?? "").trim();
  if (!v) return "";
  if (v.toLowerCase().includes(singular)) return v;
  return v === "1" ? v + " " + singular : v + " " + plural;
}

---

<Base
  titulo={d.titulo}
  descripcion={d.descripcion}
  ruta={ruta}
  ogTitulo={d.ogTitulo}
  ogDescripcion={d.ogDescripcion}
  indexable={d.publicado}
  jsonLd={fichaNegocio}
  avisoBorrador={d.avisoBorrador}
>

  <Cabecera enlaces={menuFicha} enlacesMovil={enlacesMovil} cta={ctaConsultar} />

  <main id="contenido">

    {/* ===== 1. PORTADA ===== */}
    <section class="hero hero--interior">
      <div class="contenedor hero__contenido">
        <span class="hero__etiqueta">{d.zona}</span>
        <h1 class="hero__titulo"><Marca texto={d.nombre} pendiente={!d.publicado} /></h1>
        <p class="hero__texto">
          <Marca texto={d.presentacion} pendiente={d.presentacionPendiente} />
        </p>
        <div class="grupo-botones">
          <a class="boton boton--whatsapp boton--grande" href="#contacto"
             data-whatsapp={`Hola, me interesa ${d.nombre} de Atheron Suite en Zipaquira. Quiero consultar disponibilidad.`}>
            Consultar disponibilidad
          </a>
          {hayGaleria && <a class="boton boton--claro boton--grande" href="#galeria">Ver fotos</a>}
        </div>

        {/* Datos duros arriba: es lo que la gente busca confirmar */}
        <div class="hero__datos">
          {d.datos.map((dato) => (
            <div class="dato">
              <span class="dato__numero"><Marca texto={dato.numero} pendiente={dato.pendiente} /></span>
              <span class="dato__texto">{dato.texto}</span>
            </div>
          ))}
        </div>
      </div>
    </section>


    {/* ===== 2. DESCRIPCION + CARACTERISTICAS ===== */}
    <section class="seccion">
      <div class="contenedor bloque-doble aparecer">

        <div class="bloque-doble__texto">
          <span class="etiqueta">El hospedaje</span>
          <h2><Marca texto={d.tituloDescripcion} pendiente={d.tituloDescripcionPendiente} /></h2>

          {/* El texto largo viene del cuerpo del archivo .md */}
          <div class="texto-suave ficha__descripcion">
            <Content />
          </div>

          <h3 style="margin-bottom: var(--esp-2);">Caracteristicas</h3>
          <ul class="lista-check">
            {d.caracteristicas.map((c) => (
              <li><Marca texto={c.texto} pendiente={c.pendiente} /></li>
            ))}
          </ul>
        </div>

        <div class="bloque-doble__media">
          {/* La foto principal va con las mismas variantes que en main:
               AVIF y WebP en cuatro anchos, y el JPEG de respaldo. Se
               quita forma="alto" porque la foto aprobada es 4:3 y en 3:4
               habria que recortarla. */}
          <Foto
            src={d.fotoPrincipal}
            alt={d.fotoPrincipalAlt}
            anchos={[400, 600, 700, 900]}
            medidas="(min-width: 900px) 540px, calc(100vw - 3rem)"
            ancho={900}
            alto={675}
          >Foto principal pendiente</Foto>
        </div>

      </div>
    </section>


    {/* ===== 3. HABITACIONES ===== */}
    {hayHabitaciones && (
    <section class="seccion seccion--alterna" id="habitaciones">
      <div class="contenedor">

        <div class="encabezado-seccion aparecer">
          <span class="etiqueta">Habitaciones</span>
          <h2>Donde vas a dormir</h2>
          {d.notaHabitaciones && (
            <p class="texto-suave" style="margin-top: var(--esp-2);">{d.notaHabitaciones}</p>
          )}
        </div>

        <div class="grid aparecer">
          {d.habitaciones.map((h) => (
            <article class="habitacion">
              <Foto src={h.foto} alt={h.fotoAlt}>Foto pendiente</Foto>
              <div>
                <h3><Marca texto={h.nombre} pendiente={h.pendiente} /></h3>
                <div class="habitacion__datos">
                  <span class="habitacion__dato"><Marca texto={dato(h.huespedes, "huesped", "huespedes")} pendiente={h.pendiente} /></span>
                  <span class="habitacion__dato"><Marca texto={dato(h.camas, "cama", "camas")} pendiente={h.pendiente} /></span>
                  <span class="habitacion__dato"><Marca texto={dato(h.banos, "bano", "banos")} pendiente={h.pendiente} /></span>
                </div>
                <p class="texto-suave"><Marca texto={h.descripcion} pendiente={h.pendiente} /></p>
                <div class="tarjeta__pie">
                  <span class="tarjeta__precio">
                    <Marca texto={h.precio} pendiente={h.pendiente} /> <span>/ noche</span>
                  </span>
                  <a class="boton boton--whatsapp" href="#contacto"
                     data-whatsapp={`Hola, quiero consultar por una habitacion en ${d.nombre} de Atheron Suite.`}>
                    Consultar
                  </a>
                </div>
              </div>

              {/* Galeria propia de la habitacion. Reutiliza la misma
                   rejilla que la galeria del hospedaje: la primera foto
                   ocupa el doble. Si la habitacion no tiene fotos, este
                   bloque no existe y la tarjeta se ve igual que antes. */}
              {h.galeria.length > 0 && (
                <div class="galeria" data-galeria style="grid-column: 1 / -1;">
                  {h.galeria.map((f, i) => (
                    <button
                      type="button"
                      class="galeria__abrir"
                      data-foto={i + 1}
                      aria-label={`Ampliar foto ${i + 1} de ${h.galeria.length}: ${f.alt}`}
                    >
                      <Foto src={f.imagen} alt={f.alt} forma="cuadrado" />
                    </button>
                  ))}
                </div>
              )}
            </article>
          ))}
        </div>
      </div>
    </section>
    )}


    {/* ===== 4. GALERIA ===== */}
    {hayGaleria && (
    <section class="seccion" id="galeria">
      <div class="contenedor">
        <div class="encabezado-seccion encabezado-seccion--centrado aparecer">
          <span class="etiqueta">Galeria</span>
          <h2>Fotos del hospedaje</h2>
        </div>
        {/* Si todavia no hay fotos subidas, se pintan los cinco
             rectangulos de siempre para que la seccion no se vea rota.
             En cuanto subes la primera desde el panel, la galeria pasa
             a mostrar solo las fotos reales. */}
        <div class="galeria aparecer">
          {d.galeria.length > 0
            ? d.galeria.map((f) => (
                <div><Foto src={f.imagen} alt={f.alt} forma="cuadrado" /></div>
              ))
            : [1, 2, 3, 4, 5].map((n) => (
                <div><Foto forma="cuadrado">Foto {n}</Foto></div>
              ))}
        </div>
      </div>
    </section>
    )}


    {/* ===== 5. UBICACION ===== */}
    <section class="seccion seccion--alterna" id="ubicacion">
      <div class="contenedor bloque-doble aparecer">

        <div class="bloque-doble__texto">
          <span class="etiqueta">Ubicacion</span>
          <h2>{d.zona}</h2>
          <p class="texto-suave" style="margin-block: var(--esp-2) var(--esp-3);">
            <Marca texto={d.descripcionZona} pendiente={d.descripcionZonaPendiente} />
          </p>

          <ul class="lista-distancias">
            {d.distancias.map((f) => (
              <li><span>{f.lugar}</span> <span><Marca texto={f.valor} pendiente={f.pendiente} /></span></li>
            ))}
          </ul>

          {d.horarios.length > 0 && (
            <>
              <h3 style="margin-top: var(--esp-4); margin-bottom: var(--esp-2);">Horarios</h3>
              <ul class="lista-distancias">
                {d.horarios.map((f) => (
                  <li><span>{f.lugar}</span> <span><Marca texto={f.valor} pendiente={f.pendiente} /></span></li>
                ))}
              </ul>
            </>
          )}

          {/* ==========================================================
               POLITICA DE DIRECCION
               Solo aparece en los hospedajes aliados, cuya direccion
               exacta no publicamos. No es un detalle legal escondido:
               se explica de frente y se convierte en una senal de
               seriedad.
               ========================================================== */}
          {!d.direccionPublica && (
            <div class="nota-reserva" style="margin-top: var(--esp-3);">
              <span class="nota-reserva__icono" aria-hidden="true">&#128274;</span>
              <div>
                <strong>La direccion exacta se entrega al confirmar</strong>
                Coordinamos la llegada contigo una vez la reserva esta confirmada.
                Asi protegemos la tranquilidad de los huespedes que ya estan
                alojados y nos aseguramos de recibirte bien el dia de tu llegada.
              </div>
            </div>
          )}
        </div>

        <div class="bloque-doble__media">
          {/* Si la ficha tiene coordenadas, el recuadro ademas planta el
               marcador en el portal. Salen del mismo par que alimenta "geo"
               en el JSON-LD, asi que el mapa y lo que lee Google no pueden
               acabar diciendo cosas distintas. */}
          <iframe
            class="mapa"
            title={d.mapaTitulo}
            src={`https://www.openstreetmap.org/export/embed.html?bbox=${d.mapaBbox}&layer=mapnik${
              d.latitud != null && d.longitud != null
                ? `&marker=${d.latitud}%2C${d.longitud}`
                : ''
            }`}
            loading="lazy"></iframe>
          {/* Navegacion directa desde el celular. Los tres enlaces llevan
               las coordenadas exactas, no la direccion escrita: asi el
               telefono va al portal y no a lo que el buscador entienda de
               "Cra. 9 #10-32".

               Son enlaces https normales, no esquemas propios de cada app
               (nada de "waze://" ni "comgooglemaps://"). Android e iOS los
               reconocen como enlaces de esas apps y las abren si estan
               instaladas; si no lo estan, se abre la version web. Un
               esquema propio, en cambio, deja al visitante con un error
               cuando no tiene la app.

               Salen del mismo par de coordenadas que alimenta "geo" y el
               marcador del mapa, asi que los tres no pueden desalinearse. */}
          {coordenadas && (
            <nav class="botones-mapa" aria-label={`Como llegar al ${d.nombre}`}>
              <a class="boton boton--primario" target="_blank" rel="noopener"
                 href={`https://www.google.com/maps/search/?api=1&query=${coordenadas}`}
              >Abrir en Google Maps</a>
              <a class="boton boton--contorno" target="_blank" rel="noopener"
                 href={`https://waze.com/ul?ll=${coordenadas}&navigate=yes`}
              >Abrir en Waze</a>
              <a class="boton boton--contorno" target="_blank" rel="noopener"
                 href={`https://www.google.com/maps/dir/?api=1&destination=${coordenadas}&travelmode=walking`}
              >Como llegar caminando</a>
            </nav>
          )}
          {d.enlaceMapa && (
            <p class="campo__ayuda" style="margin-top: var(--esp-2);">
              {d.calle && <>{d.calle}, Zipaquira, Cundinamarca, Colombia &middot; </>}
              <a href={d.enlaceMapa} target="_blank" rel="noopener">
                ver la ficha en Google Maps
              </a>
            </p>
          )}
          {d.mapaNota && (
            <p class="campo__ayuda" style="margin-top: var(--esp-1);">
              <Marca texto={d.mapaNota} pendiente={d.mapaNotaPendiente} />
            </p>
          )}
        </div>

      </div>
    </section>


    {/* ===== 6. EXPERIENCIAS ===== */}
    {experiencias.length > 0 && (
    <section class="seccion">
      <div class="contenedor">
        <div class="encabezado-seccion aparecer">
          <span class="etiqueta">Experiencias</span>
          <h2>Que hacer alrededor</h2>
        </div>
        <div class="grid grid--3 aparecer">
          {experiencias.map((e) => (
            <article class="experiencia">
              <div class="experiencia__fondo"></div>
              <div class="experiencia__texto">
                <h3><Marca texto={e.titulo} pendiente={e.pendiente} /></h3>
                <p><Marca texto={e.texto} pendiente={e.pendiente} /></p>
              </div>
            </article>
          ))}
        </div>

        <div style="margin-top: var(--esp-4);">
          <p class="texto-suave">
            Te contamos mas en nuestra
            <a href="/blog/guia-de-zipaquira">guia de Zipaquira</a>.
          </p>
        </div>
      </div>
    </section>
    )}


    {/* ===== 7. CONTACTO ===== */}
    <section class="seccion seccion--alterna" id="contacto">
      <div class="contenedor bloque-doble aparecer">

        <div class="bloque-doble__texto">
          <span class="etiqueta">Consulta</span>
          <h2>{d.tituloContacto}</h2>
          <p class="texto-suave" style="margin-block: var(--esp-2) var(--esp-3);">
            La forma mas rapida es WhatsApp: te respondemos con disponibilidad
            y precio para tus fechas.
          </p>

          <div class="grupo-botones" style="margin-bottom: var(--esp-3);">
            <a class="boton boton--whatsapp boton--grande" href="tel:+573188983167"
               data-whatsapp={`Hola, quiero reservar en ${d.nombre} de Atheron Suite. Estas son mis fechas:`}>
              Escribir por WhatsApp
            </a>
          </div>

          <ul class="lista-check">
            <li>Telefono: <a href="tel:+573188983167">+57 318 898 3167</a></li>
            {d.datosContacto.map((linea) => <li>{linea}</li>)}
          </ul>
        </div>

        <div class="bloque-doble__media">
          {formularioContactoActivo ? (
          <form class="formulario" data-formulario-contacto novalidate>
            <div class="formulario__fila">
              <div class="campo">
                <label for="h-nombre">Nombre</label>
                <input type="text" id="h-nombre" name="nombre" required autocomplete="name" />
              </div>
              <div class="campo">
                <label for="h-telefono">Telefono</label>
                <input type="tel" id="h-telefono" name="telefono" autocomplete="tel" />
              </div>
            </div>
            <div class="campo">
              <label for="h-correo">Correo electronico</label>
              <input type="email" id="h-correo" name="correo" required autocomplete="email" />
            </div>
            <div class="formulario__fila">
              <div class="campo">
                <label for="h-llegada">Llegada</label>
                <input type="date" id="h-llegada" name="llegada" />
              </div>
              <div class="campo">
                <label for="h-salida">Salida</label>
                <input type="date" id="h-salida" name="salida" />
              </div>
            </div>
            <div class="campo">
              <label for="h-mensaje">Mensaje</label>
              <textarea id="h-mensaje" name="mensaje"></textarea>
            </div>
            <button class="boton boton--primario boton--grande" type="submit">Enviar consulta</button>
            <div class="aviso-formulario" data-aviso-formulario role="status"></div>
          </form>
          ) : (
            <ContactoWhatsApp mensaje={`Hola, me interesa ${d.nombre} de Atheron Suite en Zipaquira.`} />
          )}
        </div>

      </div>
    </section>

  </main>

  <Pie textoVuelta="Ver todos los hospedajes" hrefVuelta="/hospedajes" />

  <BotonFlotante
    href="#contacto"
    mensaje={`Hola, me interesa ${d.nombre} de Atheron Suite en Zipaquira.`}
  />

  {/* ===== VISOR DE FOTOS (lightbox) =====
       Portado tal cual desde main. <dialog> nativo: el navegador ya
       trae el fondo oscuro, el cierre con ESC y el foco atrapado
       dentro. El guion son 4 KB sin dependencias y va con defer.
       Solo se monta si la habitacion tiene fotos que ampliar. */}
  {hayHabitaciones && d.habitaciones.some((h) => h.galeria.length > 0) && (
    <>
      <dialog class="visor" id="visor" aria-label={`Fotos de ${d.nombre}`}>
        <button type="button" class="visor__cerrar" data-visor-cerrar aria-label="Cerrar">&times;</button>
        <button type="button" class="visor__paso visor__paso--antes" data-visor-antes aria-label="Foto anterior">&lsaquo;</button>
        <figure class="visor__marco">
          <img class="visor__foto" id="visor-foto" alt="" />
          <figcaption class="visor__pie"><span data-visor-cuenta></span> <span data-visor-alt></span></figcaption>
        </figure>
        <button type="button" class="visor__paso visor__paso--despues" data-visor-despues aria-label="Foto siguiente">&rsaquo;</button>
      </dialog>

      <script is:inline defer src="/assets/js/lightbox.js"></script>
    </>
  )}

</Base>
