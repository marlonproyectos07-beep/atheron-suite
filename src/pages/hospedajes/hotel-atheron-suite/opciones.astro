---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Cabecera from '../../../components/Cabecera.astro';
import Pie from '../../../components/Pie.astro';
import BotonFlotante from '../../../components/BotonFlotante.astro';
import Foto from '../../../components/Foto.astro';
import { menuFicha, menuFichaMovil, ctaConsultar } from '../../../data/navegacion';

const fichas = await getCollection('hospedajes');
const ficha = fichas.find((item) => item.id === 'hotel-atheron-suite');
if (!ficha) throw new Error('No se encontro hotel-atheron-suite');
const d = ficha.data;

function dato(valor, singular, plural) {
  const v = String(valor ?? '').trim();
  if (!v) return '';
  if (v.toLowerCase().includes(singular)) return v;
  return v === '1' ? `${v} ${singular}` : `${v} ${plural}`;
}

function idHabitacion(nombre) {
  return nombre
    .toLowerCase()
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/(^-|-$)/g, '');
}

const casa = {
  nombre: 'Casa completa',
  huespedes: 'Hasta 22 huespedes',
  habitaciones: '5 habitaciones',
  descripcion:
    'Para familias, grupos de amigos, empresas o viajeros que quieren hospedarse juntos. Reserva las cinco habitaciones de Atheron Suite en una sola propiedad.',
  foto: d.fotoPrincipal,
  fotoAlt: d.fotoPrincipalAlt,
};
---

<Base
  titulo="Elige tu alojamiento | Hotel Atheron Suite"
  descripcion="Elige una de las cinco habitaciones de Atheron Suite o reserva la casa completa para grupos de hasta 22 huespedes en Zipaquira."
  ruta="/hospedajes/hotel-atheron-suite/opciones"
  indexable={false}
>
  <Cabecera enlaces={menuFicha} enlacesMovil={menuFichaMovil} cta={ctaConsultar} />

  <main id="contenido" class="opciones">
    <section class="opciones__hero">
      <div class="contenedor opciones__hero-contenido">
        <span class="etiqueta">Hotel Atheron Suite · Zipaquira</span>
        <h1>Elige como quieres hospedarte</h1>
        <p class="texto-suave">
          Puedes reservar una habitacion individual o, si viajas en grupo, tomar la casa completa para hasta 22 personas.
        </p>
      </div>
    </section>

    <section class="seccion" id="opciones">
      <div class="contenedor">
        <div class="opciones__bloque-titulo">
          <span class="opciones__ceja">¿Viajan juntos?</span>
          <h2>Casa completa para grupos</h2>
        </div>

        <article class="opcion opcion--casa">
          <div class="opcion__foto opcion__foto--casa">
            <Foto src={casa.foto} alt={casa.fotoAlt} forma="alto">Foto del hospedaje</Foto>
          </div>
          <div class="opcion__contenido">
            <span class="opcion__insignia">Mejor opcion para grupos</span>
            <h3>{casa.nombre}</h3>
            <div class="opcion__datos">
              <span>{casa.huespedes}</span>
              <span>{casa.habitaciones}</span>
            </div>
            <p class="texto-suave">{casa.descripcion}</p>
            <p class="opcion__precio">Precio para grupos: consultar</p>
            <div class="opcion__acciones">
              <a class="boton boton--oscuro" href="#casa-completa">Ver casa completa</a>
              <a
                class="boton boton--whatsapp"
                href="#contacto"
                data-whatsapp="Hola, quiero cotizar la casa completa de Hotel Atheron Suite para un grupo de hasta 22 personas."
              >Cotizar grupo</a>
            </div>
          </div>
        </article>

        <div class="opciones__bloque-titulo opciones__bloque-titulo--habitaciones">
          <span class="opciones__ceja">¿Prefieres una habitacion?</span>
          <h2>Conoce las cinco opciones</h2>
          <p class="texto-suave">Compara primero y entra solo a la habitacion que te interese.</p>
        </div>

        <div class="opciones__grid">
          {d.habitaciones.map((h) => {
            const id = idHabitacion(h.nombre);
            const datos = [
              dato(h.huespedes, 'huesped', 'huespedes'),
              dato(h.camas, 'cama', 'camas'),
              dato(h.banos, 'bano', 'banos'),
            ].filter(Boolean).slice(0, 2);

            return (
              <article class="opcion opcion--habitacion">
                <a class="opcion__foto" href={`#detalle-${id}`} aria-label={`Ver ${h.nombre}`}>
                  <Foto src={h.foto} alt={h.fotoAlt} forma="alto">Foto de la habitacion</Foto>
                </a>
                <div class="opcion__contenido">
                  <h3>{h.nombre}</h3>
                  <div class="opcion__datos">
                    {datos.map((texto) => <span>{texto}</span>)}
                  </div>
                  <p class="opcion__resumen texto-suave">{h.descripcion}</p>
                  <div class="opcion__pie">
                    <strong>{h.precio}</strong>
                    <a class="boton boton--oscuro" href={`#detalle-${id}`}>Ver habitacion</a>
                  </div>
                </div>
              </article>
            );
          })}
        </div>
      </div>
    </section>

    <section class="seccion seccion--alterna opciones__detalles" aria-label="Detalles de las opciones">
      <div class="contenedor">
        <article class="detalle detalle--casa" id="casa-completa">
          <a class="detalle__volver" href="#opciones">← Volver a las opciones</a>
          <div class="detalle__cabecera">
            <div>
              <span class="opciones__ceja">Para grupos grandes</span>
              <h2>Casa completa · hasta 22 huespedes</h2>
              <p class="texto-suave">
                Reserva las cinco habitaciones de Atheron Suite para que tu grupo se hospede en una sola propiedad. Es una opcion pensada para familias numerosas, grupos de amigos, empresas y viajeros que quieren permanecer juntos.
              </p>
              <div class="opcion__datos">
                <span>Hasta 22 huespedes</span>
                <span>5 habitaciones</span>
                <span>Una sola propiedad</span>
              </div>
              <a
                class="boton boton--whatsapp boton--grande"
                href="#contacto"
                data-whatsapp="Hola, quiero cotizar la casa completa de Hotel Atheron Suite para mi grupo. Somos varias personas y quiero consultar disponibilidad y precio."
              >Cotizar casa completa</a>
            </div>
            <Foto src={casa.foto} alt={casa.fotoAlt}>Foto del Hotel Atheron Suite</Foto>
          </div>

          <div class="detalle__incluye">
            <h3>Las cinco habitaciones incluidas</h3>
            <div class="detalle__mini-grid">
              {d.habitaciones.map((h) => {
                const id = idHabitacion(h.nombre);
                return (
                  <a class="detalle__mini" href={`#detalle-${id}`}>
                    <Foto src={h.foto} alt={h.fotoAlt} forma="cuadrado">Foto</Foto>
                    <strong>{h.nombre}</strong>
                  </a>
                );
              })}
            </div>
          </div>
        </article>

        {d.habitaciones.map((h, indice) => {
          const id = idHabitacion(h.nombre);
          return (
            <article class="detalle detalle--habitacion" id={`detalle-${id}`}>
              <a class="detalle__volver" href="#opciones">← Ver todas las opciones</a>
              <div class="detalle__cabecera detalle__cabecera--habitacion">
                <Foto src={h.foto} alt={h.fotoAlt}>Foto principal de la habitacion</Foto>
                <div>
                  <span class="opciones__ceja">Opcion {indice + 1} de {d.habitaciones.length}</span>
                  <h2>{h.nombre}</h2>
                  <div class="opcion__datos">
                    {[
                      dato(h.huespedes, 'huesped', 'huespedes'),
                      dato(h.camas, 'cama', 'camas'),
                      dato(h.banos, 'bano', 'banos'),
                    ].filter(Boolean).map((texto) => <span>{texto}</span>)}
                  </div>
                  <p class="texto-suave">{h.descripcion}</p>
                  <div class="detalle__precio-cta">
                    <strong>{h.precio}</strong>
                    <a
                      class="boton boton--whatsapp"
                      href="#contacto"
                      data-whatsapp={`Hola, quiero consultar disponibilidad y precio de ${h.nombre} en Hotel Atheron Suite.`}
                    >Consultar esta habitacion</a>
                  </div>
                </div>
              </div>

              {h.galeria.length > 0 && (
                <div class="detalle__galeria">
                  {h.galeria.map((f) => (
                    <Foto src={f.imagen} alt={f.alt} forma="cuadrado">Foto de la habitacion</Foto>
                  ))}
                </div>
              )}

              {h.video && (
                <div class="detalle__video-bloque">
                  <h3>Video de la habitacion</h3>
                  <video
                    class="detalle__video"
                    controls
                    preload="none"
                    poster={h.video.poster}
                    width={h.video.ancho}
                    height={h.video.alto}
                  >
                    <source src={h.video.src} type="video/mp4" />
                    Tu navegador no puede reproducir este video.
                  </video>
                </div>
              )}
            </article>
          );
        })}
      </div>
    </section>

    <section class="seccion">
      <div class="contenedor">
        <div class="cta-final">
          <h2>¿No sabes cual opcion elegir?</h2>
          <p>Cuéntanos cuantas personas viajan y te ayudamos a elegir entre una habitacion o la casa completa.</p>
          <a
            class="boton boton--whatsapp boton--grande"
            href="#contacto"
            data-whatsapp="Hola, somos un grupo y quiero que me recomienden la mejor opcion de alojamiento en Hotel Atheron Suite."
          >Hablar por WhatsApp</a>
        </div>
      </div>
    </section>
  </main>

  <Pie />
  <BotonFlotante />
</Base>

<style>
  .opciones__hero {
    padding: clamp(3.5rem, 7vw, 6.5rem) 0 2.5rem;
    background: linear-gradient(180deg, var(--color-crema), #fff);
  }
  .opciones__hero-contenido { max-width: 760px; }
  .opciones__hero h1 { margin: .7rem 0 1rem; }
  .opciones__hero p { font-size: 1.08rem; max-width: 62ch; }

  .opciones__bloque-titulo { margin-bottom: 1.5rem; }
  .opciones__bloque-titulo--habitaciones { margin-top: 3.5rem; }
  .opciones__ceja {
    display: inline-block;
    margin-bottom: .45rem;
    color: var(--color-verde);
    font-size: .82rem;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .opcion {
    overflow: hidden;
    background: #fff;
    border: 1px solid var(--borde);
    border-radius: var(--radio-md);
    box-shadow: 0 10px 30px rgba(15, 23, 42, .06);
  }
  .opcion--casa {
    display: grid;
    border: 2px solid color-mix(in srgb, var(--color-verde) 35%, var(--borde));
  }
  .opcion__foto { display: block; min-width: 0; }
  .opcion__foto :global(.foto) { width: 100%; height: 100%; object-fit: cover; }
  .opcion__foto--casa { min-height: 280px; }
  .opcion__contenido { padding: 1.35rem; min-width: 0; }
  .opcion__contenido h3 { margin-bottom: .7rem; }
  .opcion__insignia {
    display: inline-flex;
    padding: .35rem .7rem;
    margin-bottom: .7rem;
    border-radius: 999px;
    background: var(--color-verde);
    color: #fff;
    font-size: .77rem;
    font-weight: 700;
  }
  .opcion__datos { display: flex; flex-wrap: wrap; gap: .45rem; margin: .7rem 0 1rem; }
  .opcion__datos span {
    padding: .35rem .7rem;
    border-radius: 999px;
    background: var(--color-crema);
    font-size: .82rem;
  }
  .opcion__precio { font-weight: 700; margin-top: 1rem; }
  .opcion__acciones { display: flex; flex-wrap: wrap; gap: .7rem; margin-top: 1.2rem; }

  .opciones__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
    gap: 1rem;
  }
  .opcion--habitacion { display: flex; flex-direction: column; }
  .opcion--habitacion .opcion__foto { aspect-ratio: 4 / 3; overflow: hidden; }
  .opcion--habitacion .opcion__contenido { display: flex; flex-direction: column; flex: 1; }
  .opcion__resumen {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    font-size: .92rem;
  }
  .opcion__pie {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: .7rem;
    margin-top: auto;
    padding-top: 1.1rem;
  }

  .opciones__detalles { padding-top: 1rem; }
  .detalle {
    display: none;
    scroll-margin-top: 6.5rem;
    padding: clamp(1.1rem, 3vw, 2rem);
    background: #fff;
    border: 1px solid var(--borde);
    border-radius: var(--radio-lg);
    box-shadow: 0 16px 42px rgba(15, 23, 42, .08);
  }
  .detalle:target { display: block; animation: detalleEntrada .25s ease-out; }
  @keyframes detalleEntrada { from { opacity: 0; transform: translateY(8px); } }
  .detalle__volver {
    display: inline-flex;
    margin-bottom: 1.4rem;
    color: var(--color-verde);
    font-weight: 700;
  }
  .detalle__cabecera { display: grid; gap: 1.5rem; align-items: center; }
  .detalle__cabecera h2 { margin: .35rem 0 .8rem; }
  .detalle__precio-cta { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem; margin-top: 1.2rem; }
  .detalle__precio-cta strong { font-size: 1.1rem; }
  .detalle__incluye { margin-top: 2.2rem; }
  .detalle__mini-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: .8rem;
    margin-top: 1rem;
  }
  .detalle__mini {
    overflow: hidden;
    border: 1px solid var(--borde);
    border-radius: var(--radio-md);
    background: var(--color-crema);
    color: inherit;
    text-decoration: none;
  }
  .detalle__mini strong { display: block; padding: .7rem; }
  .detalle__galeria {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: .7rem;
    margin-top: 1.5rem;
  }
  .detalle__video-bloque { margin-top: 2rem; }
  .detalle__video {
    display: block;
    width: min(100%, 420px);
    max-height: 680px;
    margin-top: 1rem;
    border-radius: var(--radio-md);
    background: #000;
  }

  @media (min-width: 780px) {
    .opcion--casa { grid-template-columns: minmax(280px, .9fr) 1.35fr; }
    .opcion__foto--casa { min-height: 360px; }
    .detalle__cabecera { grid-template-columns: 1.05fr .95fr; }
    .detalle__cabecera--habitacion { grid-template-columns: minmax(280px, .85fr) 1.15fr; }
    .detalle__galeria { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .detalle__galeria > :first-child { grid-column: span 2; grid-row: span 2; }
  }

  @media (max-width: 560px) {
    .opciones__grid { grid-template-columns: 1fr; }
    .opcion__acciones .boton, .opcion__pie .boton { width: 100%; justify-content: center; }
    .detalle__galeria { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
