---
/* ============================================================
   LISTADO DE LOS 7 HOSPEDAJES

   Antes: siete bloques de HTML casi identicos, copiados a mano.
   Cambiar el texto del boton de WhatsApp obligaba a editarlo
   siete veces, y bastaba con olvidarse de uno para que quedara
   descuadrado.

   Ahora: los datos estan arriba, en una lista, y la maqueta se
   escribe UNA vez. Anadir un hospedaje es anadir una linea.

   En la Etapa 3 esta misma lista se muda a src/content/hospedajes/
   y pasa a editarse desde el panel: ahi es donde se cierran los
   pendientes 1 a 7 (nombres, zonas, capacidad, precios) sin tocar
   una sola linea de codigo.
   ============================================================ */

import Base from '../../layouts/Base.astro';
import Cabecera from '../../components/Cabecera.astro';
import Pie from '../../components/Pie.astro';
import BotonFlotante from '../../components/BotonFlotante.astro';
import { menuHospedajes, ctaDisponibilidad } from '../../data/navegacion';

interface Hospedaje {
  /** Numero que se ve en la insignia de la tarjeta. */
  numero: string;
  /** Ultima parte de la direccion: /hospedajes/<slug> */
  slug: string;
  nombre: string;
  /** true mientras falten los datos reales: pinta el texto en amarillo. */
  enObra: boolean;
  /** Primer dato de la linea gris: zona o barrio. */
  sector: string;
  /** Segundo dato: distancia, habitaciones... */
  segundoDato: string;
  descripcion: string;
  /** Mensaje que llega ya escrito a WhatsApp. */
  mensaje: string;
}

