---
/* ============================================================
   LANDING DE GRUPOS — Casas completas en Zipaquira

   Es la pagina de mayor retorno del sitio: un grupo de 40
   personas por 10 noches vale lo que decenas de reservas
   individuales, y ademas suele repetir cada temporada.

   Como la anterior, va SIN menu: un solo objetivo, cotizar.
   ============================================================ */

import Base from '../../layouts/Base.astro';
import Cabecera from '../../components/Cabecera.astro';
import Pie from '../../components/Pie.astro';
import BotonFlotante from '../../components/BotonFlotante.astro';
import { ctaLandingGrupos } from '../../data/navegacion';
import ContactoWhatsApp from '../../components/ContactoWhatsApp.astro';
import { formularioContactoActivo } from '../../data/ajustes';

const fichaServicio = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Alojamiento para grupos y empresas en Zipaquira',
  description: 'Casas completas en Zipaquira para empresas, constructoras, equipos deportivos y grupos grandes. Tarifa por volumen y estancias largas.',
  serviceType: 'Alojamiento para grupos',
  areaServed: {
    '@type': 'City',
    name: 'Zipaquira',
    containedInPlace: {
      '@type': 'AdministrativeArea',
      name: 'Cundinamarca, Colombia',
    },
  },
  provider: {
    '@type': 'Organization',
    name: 'Atheron Suite',
    url: 'https://hotelesatheron.com/',
    telephone: '+573188983167',
  },
};
---

<Base
  titulo="Casas para grupos en Zipaquira | Alojamiento para empresas y grupos grandes"
  descripcion="Casas completas para grupos en Zipaquira: empresas, constructoras, equipos deportivos, clubes de ciclismo y moteros. Hemos alojado grupos de hasta 60 personas. Sin estancia minima y con factura electronica."
  ruta="/landing/casas-para-grupos-en-zipaquira"
  ogTitulo="Casas para grupos en Zipaquira | Atheron Suite"
  ogDescripcion="Alojamiento para empresas, constructoras y grupos grandes en Zipaquira. Casas completas, tarifa por volumen y facturacion."
  jsonLd={fichaServicio}
  avisoBorrador="Version de trabajo. Faltan fotos y confirmar capacidades exactas por casa."
>

  <Cabecera cta={ctaLandingGrupos} />

  <main id="contenido">

    {/* ==========================================================
         1. HERO
         ========================================================== */}
    <section class="hero">
      <div class="contenedor hero__contenido">

        <span class="hero__etiqueta">Grupos y empresas &middot; Zipaquira</span>

        <h1 class="hero__titulo">
          Casas completas para <em>grupos grandes</em> en Zipaquira
        </h1>

        <p class="hero__texto">
          Empresas, constructoras, equipos deportivos, clubes de ciclismo o
          moteros: si viajan varios, no necesitan habitaciones sueltas.
          Necesitan la casa entera, tarifa por volumen y alguien que responda
          rapido. Eso es lo que hacemos.
        </p>

        <div class="grupo-botones">
          <a class="boton boton--whatsapp boton--grande" href="#cotizar"
             data-whatsapp="Hola, necesito alojamiento para un grupo en Zipaquira. Somos [numero] personas y las fechas son [fechas].">
            Cotizar por WhatsApp
          </a>
          <a class="boton boton--claro boton--grande" href="#como-funciona">Como funciona</a>
        </div>

        <div class="hero__datos">
          <div class="dato">
            <span class="dato__numero">60</span>
            <span class="dato__texto">Personas alojadas en un solo grupo</span>
          </div>
          <div class="dato">
            <span class="dato__numero">7</span>
            <span class="dato__texto">Propiedades disponibles</span>
          </div>
          <div class="dato">
            <span class="dato__numero">2 anos</span>
            <span class="dato__texto">Recibiendo grupos</span>
          </div>
        </div>

      </div>
    </section>


    {/* ==========================================================
         2. PARA QUIEN ES
         Nombrar al cliente por su nombre es lo que hace que se
         reconozca. "Grupos" es abstracto; "club de ciclismo" no.
         ========================================================== */}
    <section class="seccion">
      <div class="contenedor">

        <div class="encabezado-seccion encabezado-seccion--centrado aparecer">
          <span class="etiqueta">Para quien es</span>
          <h2>Si viajan en grupo, esto es para ustedes</h2>
        </div>

        <div class="grid grid--3 aparecer">

          <article class="tarjeta-simple">
            <div class="tarjeta-simple__icono" aria-hidden="true">&#128679;</div>
            <h3>Empresas y constructoras</h3>
            <p class="texto-suave">
              Personal de obra o equipos de proyecto que necesitan alojamiento
              por semanas o meses. <strong>Emitimos factura electronica.</strong>
            </p>
          </article>

          <article class="tarjeta-simple">
            <div class="tarjeta-simple__icono" aria-hidden="true">&#127942;</div>
            <h3>Equipos deportivos</h3>
            <p class="texto-suave">
              Delegaciones que vienen a competencia o concentracion y necesitan
              quedarse juntas.
            </p>
          </article>

          <article class="tarjeta-simple">
            <div class="tarjeta-simple__icono" aria-hidden="true">&#128692;</div>
            <h3>Ciclistas y moteros</h3>
            <p class="texto-suave">
              Clubes de ruta que hacen base en Zipaquira. Parqueadero y espacio
              para las maquinas.
            </p>
          </article>

          <article class="tarjeta-simple">
            <div class="tarjeta-simple__icono" aria-hidden="true">&#128106;</div>
            <h3>Familias grandes</h3>
            <p class="texto-suave">
              Reuniones familiares donde nadie quiere quedarse en un hotel
              distinto al resto.
            </p>
          </article>

          <article class="tarjeta-simple">
            <div class="tarjeta-simple__icono" aria-hidden="true">&#127757;</div>
            <h3>Grupos de turismo</h3>
            <p class="texto-suave">
              Operadores y delegaciones que traen visitantes a la Catedral de Sal
              y la region.
            </p>
          </article>

          <article class="tarjeta-simple">
            <div class="tarjeta-simple__icono" aria-hidden="true">&#127895;</div>
            <h3>Grupos recurrentes</h3>
            <p class="texto-suave">
              Varios de nuestros clientes vuelven cada temporada. Si es su caso,
              hablemos de condiciones fijas.
            </p>
          </article>

        </div>
      </div>
    </section>


    {/* ==========================================================
         3. PRUEBA REAL
         Un caso concreto convence mas que diez adjetivos.
         Sin cifras de facturacion: eso es informacion interna.
         ========================================================== */}
    <section class="seccion seccion--oscura">
      <div class="contenedor">
        <div class="bloque-doble aparecer">

          <div class="bloque-doble__texto">
            <span class="etiqueta">Un caso real</span>
            <h2>60 personas, 2 casas, 10 noches</h2>
            <p class="texto-suave" style="margin-block: var(--esp-2) var(--esp-3);">
              Un grupo mexicano de sesenta personas vino a conocer la Catedral de
              Sal y la region. Los alojamos en dos casas completas durante diez
              noches, coordinando llegadas, distribucion por habitaciones y
              logistica del grupo desde un solo canal.
            </p>
            <p class="texto-suave">
              Ese es el tipo de operacion que sabemos manejar. No es lo mismo
              recibir a dos personas un fin de semana que coordinar un grupo
              grande durante una semana y media.
            </p>
          </div>

          <div class="bloque-doble__media">
            <div class="placeholder placeholder--ancho">
              Foto pendiente<br />Casa completa o grupo
            </div>
          </div>

        </div>
      </div>
    </section>


    {/* ==========================================================
         4. QUE OFRECEMOS A UN GRUPO
         ========================================================== */}
    <section class="seccion">
      <div class="contenedor bloque-doble aparecer">

        <div class="bloque-doble__texto">
          <span class="etiqueta">Que incluye</span>
          <h2>Lo que cambia cuando reservan como grupo</h2>
          <p class="texto-suave" style="margin-block: var(--esp-2) var(--esp-3);">
            No es el mismo trato que una reserva individual, y no deberia serlo.
          </p>
          <ul class="lista-check">
            <li><strong>Casa completa</strong>, no habitaciones sueltas repartidas</li>
            <li><strong>Tarifa por volumen</strong>: a mas noches y mas personas, mejor precio</li>
            <li><strong>Un solo interlocutor</strong> para toda la coordinacion</li>
            <li><strong>Cocina equipada</strong>: el grupo no depende de restaurantes</li>
            <li><strong>Parqueadero</strong> para vehiculos, bicicletas o motos</li>
            <li><strong>Factura electronica</strong>: emitimos factura, como necesita cualquier empresa</li>
            <li><strong>Sin estancia minima</strong>: desde una noche</li>
            <li><strong>Descuentos por recurrencia</strong> para grupos que vuelven cada temporada</li>
          </ul>
        </div>

        <div class="bloque-doble__media">
          <div class="placeholder placeholder--alto">Foto pendiente<br />Zona comun o comedor</div>
        </div>

      </div>
    </section>


    {/* ==========================================================
         5. COMO FUNCIONA
         Un grupo grande necesita saber que el proceso esta ordenado.
         ========================================================== */}
    <section class="seccion seccion--alterna" id="como-funciona">
      <div class="contenedor">

        <div class="encabezado-seccion aparecer">
          <span class="etiqueta">Proceso</span>
          <h2>Como funciona una reserva de grupo</h2>
        </div>

        <div class="grid grid--4 aparecer">

          <article class="tarjeta-simple">
            <div class="tarjeta-simple__icono" aria-hidden="true">1</div>
            <h3>Nos escribes</h3>
            <p class="texto-suave">Cuantas personas, que fechas y si necesitan factura.</p>
          </article>

          <article class="tarjeta-simple">
            <div class="tarjeta-simple__icono" aria-hidden="true">2</div>
            <h3>Armamos la propuesta</h3>
            <p class="texto-suave">Que casas se usan, como se distribuye el grupo y a que tarifa.</p>
          </article>

          <article class="tarjeta-simple">
            <div class="tarjeta-simple__icono" aria-hidden="true">3</div>
            <h3>Confirman</h3>
            <p class="texto-suave">Se reserva y se coordina la logistica de llegada.</p>
          </article>

          <article class="tarjeta-simple">
            <div class="tarjeta-simple__icono" aria-hidden="true">4</div>
            <h3>Llegan</h3>
            <p class="texto-suave">Los recibimos y entregamos las casas listas.</p>
          </article>

        </div>

        <div class="nota-reserva" style="margin-top: var(--esp-4);">
          <span class="nota-reserva__icono" aria-hidden="true">&#128274;</span>
          <div>
            <strong>Sobre las direcciones</strong>
            Coordinamos todo desde nuestra oficina en la Cra. 9 #10-32 de
            Zipaquira. La direccion exacta de cada casa se entrega al confirmar
            la reserva, junto con las instrucciones de llegada del grupo.
          </div>
        </div>

      </div>
    </section>


    {/* ==========================================================
         6. PREGUNTAS FRECUENTES DE UN GRUPO
         ========================================================== */}
    <section class="seccion">
      <div class="contenedor" style="max-width: 780px;">

        <div class="encabezado-seccion encabezado-seccion--centrado aparecer">
          <span class="etiqueta">Dudas</span>
          <h2>Preguntas frecuentes</h2>
        </div>

        <div class="aparecer">
          <details style="border-bottom:1px solid var(--borde); padding: var(--esp-2) 0;">
            <summary style="cursor:pointer; font-weight:600;">Cuantas personas podemos alojar?</summary>
            <p class="texto-suave" style="margin-top: var(--esp-1);">
              Hemos alojado grupos de hasta 60 personas usando dos casas completas.
              La capacidad depende de las fechas y de que propiedades esten libres.
              Escribenos con el numero exacto y te confirmamos.
            </p>
          </details>

          <details style="border-bottom:1px solid var(--borde); padding: var(--esp-2) 0;">
            <summary style="cursor:pointer; font-weight:600;">Emiten factura electronica?</summary>
            <p class="texto-suave" style="margin-top: var(--esp-1);">
              Si. Emitimos factura electronica, que es lo que necesita cualquier
              empresa o constructora para poder cargar el gasto. Solo tienes que
              pasarnos los datos de facturacion al confirmar la reserva.
            </p>
          </details>

          <details style="border-bottom:1px solid var(--borde); padding: var(--esp-2) 0;">
            <summary style="cursor:pointer; font-weight:600;">Cual es la estancia minima?</summary>
            <p class="texto-suave" style="margin-top: var(--esp-1);">
              No hay estancia minima: pueden reservar desde una sola noche.
              Si son varias noches, estudiamos la tarifa segun el volumen del
              grupo y la duracion.
            </p>
          </details>

          <details style="border-bottom:1px solid var(--borde); padding: var(--esp-2) 0;">
            <summary style="cursor:pointer; font-weight:600;">Manejan descuentos para estancias largas o grupos recurrentes?</summary>
            <p class="texto-suave" style="margin-top: var(--esp-1);">
              Si. A mayor numero de noches y de personas, mejor tarifa. Y con los
              grupos que vuelven cada temporada acordamos condiciones
              recurrentes, para que no tengan que renegociar cada vez.
            </p>
          </details>

          <details style="border-bottom:1px solid var(--borde); padding: var(--esp-2) 0;">
            <summary style="cursor:pointer; font-weight:600;">Hay parqueadero para bicicletas o motos?</summary>
            <p class="texto-suave" style="margin-top: var(--esp-1);">
              Si, contamos con parqueadero.
            </p>
          </details>

          <details style="border-bottom:1px solid var(--borde); padding: var(--esp-2) 0;">
            <summary style="cursor:pointer; font-weight:600;">Se puede reservar con anticipacion para varias temporadas?</summary>
            <p class="texto-suave" style="margin-top: var(--esp-1);">
              Si, y es lo que hacen varios de nuestros grupos recurrentes.
              Escribenos y acordamos condiciones fijas.
            </p>
          </details>
        </div>

      </div>
    </section>


    {/* ==========================================================
         7. COTIZAR
         ========================================================== */}
    <section class="seccion seccion--alterna" id="cotizar">
      <div class="contenedor bloque-doble aparecer">

        <div class="bloque-doble__texto">
          <span class="etiqueta">Cotizacion</span>
          <h2>Dinos cuantos son y para cuando</h2>
          <p class="texto-suave" style="margin-block: var(--esp-2) var(--esp-3);">
            Con el numero de personas, las fechas y si necesitan factura, te
            armamos la propuesta completa.
          </p>

          <div class="grupo-botones" style="margin-bottom: var(--esp-3);">
            <a class="boton boton--whatsapp boton--grande" href="tel:+573188983167"
               data-whatsapp="Hola, necesito cotizar alojamiento para un grupo en Zipaquira. Somos [numero] personas, del [fecha] al [fecha]. Necesitamos factura: si / no.">
              Cotizar por WhatsApp
            </a>
          </div>

          <ul class="lista-check">
            <li>Telefono: <a href="tel:+573188983167">+57 318 898 3167</a></li>
            <li>Oficina: Cra. 9 #10-32, Zipaquira, Cundinamarca</li>
            <li>Atencion directa, sin intermediarios</li>
          </ul>
        </div>

        <div class="bloque-doble__media">
          {formularioContactoActivo ? (
          <form class="formulario" data-formulario-contacto novalidate>

            <div class="formulario__fila">
              <div class="campo">
                <label for="g-nombre">Nombre y empresa</label>
                <input type="text" id="g-nombre" name="nombre" required autocomplete="organization" />
              </div>
              <div class="campo">
                <label for="g-telefono">Telefono</label>
                <input type="tel" id="g-telefono" name="telefono" autocomplete="tel" />
              </div>
            </div>

            <div class="campo">
              <label for="g-correo">Correo electronico</label>
              <input type="email" id="g-correo" name="correo" required autocomplete="email" />
            </div>

            <div class="formulario__fila">
              <div class="campo">
                <label for="g-personas">Numero de personas</label>
                <input type="number" id="g-personas" name="personas" min="1" />
              </div>
              <div class="campo">
                <label for="g-noches">Numero de noches</label>
                <input type="number" id="g-noches" name="noches" min="1" />
              </div>
            </div>

            <div class="formulario__fila">
              <div class="campo">
                <label for="g-llegada">Llegada</label>
                <input type="date" id="g-llegada" name="llegada" />
              </div>
              <div class="campo">
                <label for="g-tipo">Tipo de grupo</label>
                <select id="g-tipo" name="tipo">
                  <option>Empresa o constructora</option>
                  <option>Equipo deportivo</option>
                  <option>Club de ciclismo o motociclismo</option>
                  <option>Familia o celebracion</option>
                  <option>Grupo de turismo</option>
                  <option>Otro</option>
                </select>
              </div>
            </div>

            <div class="campo">
              <label for="g-mensaje">Cuentanos mas</label>
              <textarea id="g-mensaje" name="mensaje" placeholder="Necesitamos factura, llegamos en bus, somos 40 ciclistas..."></textarea>
            </div>

            <button class="boton boton--primario boton--grande" type="submit">
              Solicitar cotizacion
            </button>

            <div class="aviso-formulario" data-aviso-formulario role="status"></div>

          </form>
          ) : (
            <ContactoWhatsApp
              mensaje="Hola, necesito alojamiento para un grupo en Zipaquira."
              titulo="Cotiza tu grupo por WhatsApp"
              texto="Cuentanos cuantas personas son y que fechas manejan, y te enviamos una cotizacion concreta."
              textoBoton="Cotizar por WhatsApp" />
          )}
        </div>

      </div>
    </section>


    {/* ==========================================================
         8. CIERRE
         ========================================================== */}
    <section class="seccion">
      <div class="contenedor">
        <div class="cta-final aparecer">
          <h2>Traen un grupo a Zipaquira?</h2>
          <p>
            Escribanos con el numero de personas y las fechas.
            Respondemos con una propuesta concreta.
          </p>
          <div class="grupo-botones grupo-botones--centrado">
            <a class="boton boton--whatsapp boton--grande" href="#cotizar"
               data-whatsapp="Hola, traemos un grupo a Zipaquira y queremos cotizar alojamiento.">
              Cotizar ahora
            </a>
            <a class="boton boton--claro boton--grande" href="/hospedajes">Ver los hospedajes</a>
          </div>
        </div>
      </div>
    </section>

  </main>

  <Pie textoVuelta="Ir al sitio principal" />

  <BotonFlotante
    href="#cotizar"
    mensaje="Hola, necesito alojamiento para un grupo en Zipaquira."
    texto="Cotizar grupo"
  />

</Base>
