---
import Base from '../../layouts/Base.astro';
import Cabecera from '../../components/Cabecera.astro';
import Pie from '../../components/Pie.astro';
import BotonFlotante from '../../components/BotonFlotante.astro';
import { menuBlog, ctaDisponibilidad } from '../../data/navegacion';
import { articuloDe, fechaLarga } from '../../data/blog';
import { atributosWhatsApp } from '../../data/whatsapp';
import { migaDePan, url, ORGANIZACION } from '../../data/seo';

const articulo = articuloDe('/eventos/circuito-salinas-rock-festival-zipaquira-2026')!;
const fuentePrincipal = 'https://www.instagram.com/zipamesaderock/p/Ddh0cCpoxz4/';
const fuenteCultura = 'https://www.instagram.com/culturazipaquira/p/DdjgIpsRvS0/';

const bandas = [
  'Anónimos',
  'Carnage',
  'Falsos Positivos',
  'Joda Cáustica',
  'La Rodilla Mala',
  'Modo Visage',
  'Necronslaugh',
  'NómadaZ',
  'Vinirrosa',
  'Yellowknife',
];

const ficha = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BlogPosting',
      '@id': `${url(articulo.ruta)}#articulo`,
      headline: articulo.titulo,
      description: articulo.descripcion,
      url: url(articulo.ruta),
      datePublished: articulo.publicado,
      dateModified: articulo.modificado,
      inLanguage: 'es-CO',
      author: { '@type': 'Organization', name: articulo.autor },
      publisher: { '@id': ORGANIZACION['@id'] },
      citation: articulo.fuentes.map((f) => f.url ?? f.titulo),
      mainEntityOfPage: url(articulo.ruta),
    },
    {
      '@type': 'Event',
      '@id': `${url(articulo.ruta)}#evento`,
      name: 'Segundo Circuito de Salinas Rock Festival 2026',
      description: articulo.descripcion,
      startDate: '2026-10-03T14:00:00-05:00',
      eventStatus: 'https://schema.org/EventScheduled',
      eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
      location: {
        '@type': 'Place',
        name: 'Estación del Tren de Zipaquirá',
        address: {
          '@type': 'PostalAddress',
          addressLocality: 'Zipaquirá',
          addressRegion: 'Cundinamarca',
          addressCountry: 'CO',
        },
      },
      organizer: {
        '@type': 'Organization',
        name: 'Mesa de Rock de Zipaquirá',
        url: fuentePrincipal,
      },
      performer: [...bandas, 'SelektA Family'].map((nombre) => ({ '@type': 'PerformingGroup', name: nombre })),
      url: url(articulo.ruta),
      mainEntityOfPage: fuentePrincipal,
    },
    ORGANIZACION,
    migaDePan([
      { nombre: 'Inicio', ruta: '/' },
      { nombre: 'Blog', ruta: '/blog' },
      { nombre: 'Circuito de Salinas Rock Festival 2026', ruta: articulo.ruta },
    ], `${url(articulo.ruta)}#miga`),
  ],
};

const WA = 'Hola, vi la información del Circuito de Salinas Rock Festival en el blog de Atheron. Viajo a Zipaquirá y quiero consultar hospedaje.\n\nFecha de llegada:\nFecha de salida:\nNúmero de huéspedes:';
---

<Base
  titulo="Circuito de Salinas Rock Festival 2026 | Zipaquirá"
  descripcion={articulo.descripcion}
  ruta={articulo.ruta}
  ogTipo="article"
  jsonLd={ficha}
  hojasExtra={['guia', 'eventos']}
>
  <Cabecera enlaces={menuBlog} cta={{ ...ctaDisponibilidad, origen: 'evento_rock' }} actual="/blog" />

  <main id="contenido">
    <section class="evento-hero">
      <div class="contenedor evento-hero__contenido">
        <nav class="migas" aria-label="Ruta de navegación"><ol><li><a href="/">Inicio</a></li><li><a href="/blog">Blog</a></li><li aria-current="page">Circuito de Salinas Rock 2026</li></ol></nav>
        <span class="hero__etiqueta">Agenda cultural verificada</span>
        <h1>Circuito de Salinas Rock Festival 2026 en Zipaquirá</h1>
        <p class="hero__texto">Una jornada de guitarras, sonidos extremos y talento regional en la Estación del Tren. Aquí reunimos los datos confirmados y señalamos con claridad lo que el organizador todavía no ha publicado.</p>
        <span class="evento-hero__fecha">Sábado 3 de octubre de 2026 · 2:00 p. m.</span>
      </div>
    </section>

    <section class="seccion">
      <div class="contenedor articulo">
        <p class="articulo__meta"><span>Verificado el <time datetime={articulo.modificado}>{fechaLarga(articulo.modificado)}</time></span><span>Por {articulo.autor}</span></p>

        <div class="respuesta-rapida"><strong>En corto</strong> El Segundo Circuito de Salinas Rock Festival está programado para el sábado 3 de octubre de 2026, desde las 2:00 p. m., en la Estación del Tren de Zipaquirá. La publicación consultada no informa costo, inscripción, cupos ni hora de finalización.</div>

        <h2>Información confirmada</h2>
        <ul class="evento-datos">
          <li><strong>Evento:</strong> Segundo Circuito de Salinas Rock Festival 2026.</li>
          <li><strong>Fecha:</strong> sábado 3 de octubre de 2026.</li>
          <li><strong>Hora:</strong> 2:00 p. m.</li>
          <li><strong>Lugar:</strong> Estación del Tren, Zipaquirá.</li>
          <li><strong>Promueve:</strong> Mesa de Rock de Zipaquirá.</li>
          <li><strong>Costo, inscripción y aforo:</strong> no publicados en la fuente consultada.</li>
        </ul>

        <div class="evento-conversion">
          <div><h2>Consulta la publicación de origen</h2><p>La organización puede actualizar condiciones o recomendaciones. Confirma la información directamente en su publicación antes de desplazarte.</p></div>
          <div class="evento-conversion__acciones"><a class="boton boton--primario" href={fuentePrincipal} target="_blank" rel="noopener noreferrer">Ver convocatoria original</a><a class="boton boton--contorno" href={fuenteCultura} target="_blank" rel="noopener noreferrer">Ver agenda de Cultura</a></div>
        </div>

        <h2>Bandas anunciadas</h2>
        <ul class="evento-datos">
          {bandas.map((banda) => <li>{banda}</li>)}
          <li><strong>Banda invitada:</strong> SelektA Family.</li>
        </ul>

        <h2>Una escena que también cuenta la ciudad</h2>
        <p><strong>Interpretación editorial de Atheron:</strong> un circuito musical no es solamente una sucesión de conciertos. También abre un espacio para que agrupaciones emergentes encuentren público, para que distintas generaciones se reúnan y para que la ciudad reconozca sonidos creados en su propia región.</p>
        <p>La Estación del Tren convierte esa jornada en una oportunidad para vivir el patrimonio desde una expresión contemporánea. Esta lectura es editorial de Atheron; no constituye una descripción oficial del evento.</p>

        <div class="evento-nota"><strong>Antes de asistir:</strong> la fuente consultada no publica costo, registro, restricciones de edad, capacidad, parqueadero, accesibilidad ni hora de cierre. No asumimos que el ingreso sea gratuito. Revisa cualquier actualización del organizador.</div>

        <h2>Atheron te ayuda a vivir la ciudad</h2>
        <p>Si vienes desde Bogotá u otro municipio, puedes complementar la jornada con el centro histórico, la gastronomía local o una visita a la Catedral de Sal. Primero confirma las condiciones del festival; después organiza tu alojamiento según tus fechas y número de viajeros.</p>
        <p>Consulta nuestra <a href="/guia-zipaquira">Guía Atheron de Zipaquirá</a>, revisa los <a href="/hospedajes">hospedajes disponibles</a> o conoce cómo coordinamos <a href="/grupos">alojamiento para grupos</a>.</p>

        <aside class="evento-conversion" aria-label="Hospedaje en Zipaquirá">
          <div><h2>¿Vienes con una banda o un grupo?</h2><p>Cuéntanos cuántas personas viajan y para qué fechas. Te ayudamos a organizar habitaciones, apartamentos o casas; el alojamiento no incluye entrada ni vinculación con el festival.</p></div>
          <div class="evento-conversion__acciones"><a class="boton boton--whatsapp" {...atributosWhatsApp(WA, { origen: 'evento_circuito_rock' })}>Consultar hospedaje</a><a class="boton boton--claro" href="/grupos">Ver opciones para grupos</a></div>
        </aside>

        <h2>Fuentes</h2>
        <ul class="evento-fuentes">
          <li><a href={fuentePrincipal} target="_blank" rel="noopener noreferrer">Mesa de Rock de Zipaquirá — convocatoria publicada el 20 de septiembre de 2026</a></li>
          <li><a href={fuenteCultura} target="_blank" rel="noopener noreferrer">Cultura Zipaquirá — agenda cultural consultada el 22 de septiembre de 2026</a></li>
        </ul>
      </div>
    </section>
  </main>

  <Pie />
  <BotonFlotante mensaje={WA} origen="evento_circuito_rock_flotante" />
</Base>
