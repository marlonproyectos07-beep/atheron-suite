<style>
:root{--wine:#7b263b;--gold:#d8a13a;--ink:#1f1a17;--cream:#fff8ef;--green:#239b5a;--muted:#6f6259}*{box-sizing:border-box}body{margin:0;font-family:Inter,system-ui,-apple-system,"Segoe UI",sans-serif;background:linear-gradient(180deg,#fffaf4,#f7efe3);color:var(--ink)}.wrap{width:min(1120px,92vw);margin:auto}.hero{padding:54px 0 32px}.grid{display:grid;grid-template-columns:1.05fr .95fr;gap:38px;align-items:center}.badge{display:inline-flex;gap:8px;align-items:center;padding:9px 14px;border-radius:999px;background:white;border:1px solid #eadac5;color:var(--wine);font-weight:800;box-shadow:0 8px 25px #6e432817}h1{font-size:clamp(44px,6vw,78px);line-height:.96;letter-spacing:-.045em;margin:18px 0}h1 span{color:var(--wine)}.lead{font-size:21px;line-height:1.5;color:#4d423a}.price{font-size:42px;font-weight:950;margin:16px 0 4px}.sub{color:var(--muted)}.cta{display:inline-flex;align-items:center;justify-content:center;gap:10px;margin-top:18px;background:#22a45d;color:white;text-decoration:none;padding:16px 24px;border-radius:16px;font-weight:900;font-size:18px;box-shadow:0 12px 28px #22a45d3c}.photo{border-radius:28px;overflow:hidden;box-shadow:0 20px 55px #55351d27;border:1px solid #eadac5;background:#261d18}.photo img{width:100%;height:520px;object-fit:cover;display:block}.facts{display:flex;flex-wrap:wrap;gap:10px;margin:20px 0}.fact{padding:11px 14px;border-radius:14px;background:white;border:1px solid #eadac5;font-weight:800}section{padding:42px 0}.cards{display:grid;grid-template-columns:1fr 1fr;gap:24px}.card{background:#fff;border:1px solid #eadac5;border-radius:26px;padding:26px;box-shadow:0 16px 45px #64401f14}.title{font-size:40px;line-height:1.05;letter-spacing:-.03em;margin:12px 0}.big{font-size:70px;line-height:1;font-weight:950;color:var(--wine)}.meter{height:18px;background:#eee1cf;border-radius:999px;overflow:hidden;margin:18px 0 10px}.meter span{display:block;height:100%;width:100%;background:linear-gradient(90deg,var(--green),#68bd8a)}.warning{padding:17px 18px;border-radius:16px;background:#fff3db;border:1px solid #e6c37b;font-weight:750;line-height:1.45}.countdown{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-top:18px}.countdown div{background:#2f2723;color:white;text-align:center;padding:15px 6px;border-radius:15px}.countdown strong{font-size:28px;display:block}.countdown span{font-size:11px;text-transform:uppercase;opacity:.7;letter-spacing:.08em}.includes{display:grid;grid-template-columns:repeat(5,1fr);gap:12px}.item{padding:17px;border-radius:16px;background:#fff;border:1px solid #eadac5;text-align:center;font-weight:850}.love{background:var(--wine);color:white;border-radius:28px;padding:34px}.love .title{color:white}.love p{font-size:20px;line-height:1.55;margin:0}.foot{text-align:center;padding:55px 0 80px}.foot p{max-width:720px;margin:10px auto 20px;color:var(--muted);line-height:1.6}@media(max-width:820px){.grid,.cards{grid-template-columns:1fr}.photo img{height:380px}.includes{grid-template-columns:repeat(2,1fr)}.countdown{grid-template-columns:repeat(2,1fr)}.hero{padding-top:30px}}
</style>
</head>
<body>
<main>
<section class="hero"><div class="wrap grid"><div><div class="badge">❤️ Edición Amor y Amistad · Zipaquirá</div><h1>Gallina al Vapor <span>para compartir</span></h1><p class="lead">Este <strong>{fechaEntrega}</strong>, comparte con tu familia, pareja o amigos una receta especial que vuelve <strong>solo una vez al mes</strong>.</p><div class="facts"><div class="fact">🐔 Gallina</div><div class="fact">🥔 Papa</div><div class="fact">🌿 Yuca</div><div class="fact">🍌 Plátano</div><div class="fact">🌶️ Ají tradicional</div></div><div class="price">$60.000</div><div class="sub">Domicilio en Zipaquirá: <strong>$5.000 adicionales</strong></div><a class="cta" href={reservaUrl} target="_blank" rel="noopener">📲 Separar mi gallina</a></div><div class="photo"><img src="https://images.unsplash.com/photo-1604908176997-125f25cc6f3d?auto=format&fit=crop&w=1200&q=75" alt="Gallina al vapor para compartir" loading="eager" fetchpriority="high" /></div></div></section>
<section><div class="wrap cards"><div class="card"><div class="badge">🔥 Reservas abiertas</div><h2 class="title">Disponibilidad en este momento</h2><div class="big">{disponibles}</div><div style="font-size:21px;font-weight:850">unidades disponibles</div><div class="meter"><span></span></div><div class="warning">🔥 <strong>Reserva la tuya ahora.</strong> Cuando lleguemos a 0, cerramos pedidos y tendrás que esperar la próxima edición mensual.</div></div><div class="card"><div class="badge">⏳ Cierre de pedidos</div><h2 class="title">{cierre}</h2><p class="lead" style="font-size:18px">Recibimos pedidos hasta el <strong>miércoles 16 de septiembre</strong>, o antes si se agotan las unidades disponibles.</p><div class="countdown"><div><strong id="d">0</strong><span>Días</span></div><div><strong id="h">00</strong><span>Horas</span></div><div><strong id="m">00</strong><span>Min</span></div><div><strong id="s">00</strong><span>Seg</span></div></div><a class="cta" href={reservaUrl} target="_blank" rel="noopener">🐔 Quiero separar la mía</a></div></div></section>
<section><div class="wrap"><h2 class="title">Todo lo que incluye</h2><div class="includes"><div class="item">🐔 Gallina</div><div class="item">🥔 Papa</div><div class="item">🌿 Yuca</div><div class="item">🍌 Plátano</div><div class="item">🌶️ Ají tradicional</div></div></div></section>
<section><div class="wrap love"><div class="badge" style="background:#ffffff18;border-color:#ffffff35;color:white">❤️ Septiembre · Amor y Amistad</div><h2 class="title">Hay sabores que se disfrutan más cuando se comparten.</h2><p>Este mes celebra con quienes más quieres: familia, pareja, amigos o compañeros. Nuestra Gallina al Vapor se prepara únicamente por encargo y regresa una vez al mes.</p></div></section>
<section class="foot"><div class="wrap"><h2 class="title">Haz tu pedido antes del miércoles 16</h2><p>Si las unidades llegan a 0 antes del cierre, esta edición queda agotada. La próxima oportunidad será el mes siguiente.</p><a class="cta" href={reservaUrl} target="_blank" rel="noopener">📲 Reservar por WhatsApp</a></div></section>
</main>
<script is:inline>
const end=new Date('2026-09-16T23:59:59-05:00').getTime();
const d=document.getElementById('d'),h=document.getElementById('h'),m=document.getElementById('m'),s=document.getElementById('s');
function t(){const x=Math.max(0,end-Date.now());d.textContent=Math.floor(x/86400000);h.textContent=String(Math.floor((x%86400000)/3600000)).padStart(2,'0');m.textContent=String(Math.floor((x%3600000)/60000)).padStart(2,'0');s.textContent=String(Math.floor((x%60000)/1000)).padStart(2,'0')}t();setInterval(t,1000)
</script>
</body></html>