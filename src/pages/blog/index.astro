---
/* ============================================================
   BLOG — listado de articulos

   QUE ES /blog Y QUE NO ES
   El blog resuelve: como llegar, cuanto tiempo quedarse, donde
   dormir, y la historia de Atheron. Descubrir la ciudad es trabajo
   de /guia-zipaquira, y la Catedral tiene su propia pagina. Por eso
   el H1 ya no es "Descubre Zipaquira" -competia con el del hub- y
   ninguna tarjeta se presenta como "guia principal".

   EL RECORRIDO DEL HERO
   Blog -> Guia Atheron -> Catedral -> Hospedajes -> WhatsApp. Son
   enlaces reales y se ven tambien en el telefono: antes la columna
   del hero se ocultaba en movil y era texto sin enlace.

   LAS TARJETAS SALEN DEL MODELO DE DATOS
   Titulo, rotulo y fecha vienen de src/data/blog.ts: un articulo
   nuevo aparece aqui, en su ficha y en el sitemap a la vez.
   ============================================================ */

import Base from '../../layouts/Base.astro';
import Cabecera from '../../components/Cabecera.astro';
import Pie from '../../components/Pie.astro';
import BotonFlotante from '../../components/BotonFlotante.astro';

import { menuBlog, ctaDisponibilidad } from '../../data/navegacion';
import { migaDePan, url, ORGANIZACION } from '../../data/seo';
import { articulosPublicados, proximosArticulos, fechaLarga } from '../../data/blog';
import { atributosWhatsApp } from '../../data/whatsapp';

const publicados = articulosPublicados();

const WA_BLOG =
  'Hola, vengo del blog de Atheron y quiero información para planear mi estadía en Zipaquirá.\n\n' +
  'Fecha de llegada:\n' +
  'Fecha de salida:\n' +
  'Número de huéspedes:';

/* El recorrido sugerido. El cuarto paso -WhatsApp- se pinta aparte
   porque su destino se construye con el mensaje. */
const recorrido = [
  { paso: '01', titulo: 'Guía Atheron', texto: 'Qué ver en la ciudad y sus alrededores', href: '/guia-zipaquira' },
  { paso: '02', titulo: 'Catedral de Sal', texto: 'Horario, pasaportes y cómo planear la visita', href: '/zipaquira/catedral-de-sal' },
  { paso: '03', titulo: 'Hospedajes', texto: 'Dónde quedarte en Zipaquirá', href: '/hospedajes' },
];

const fichaBlog = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Blog',
      '@id': `${url('/blog')}#blog`,
      url: url('/blog'),
      name: 'Blog sobre Zipaquirá | Atheron Suite',
      description:
        'Artículos prácticos de Atheron sobre Zipaquirá: cómo llegar desde Bogotá, cuántos días quedarse y la historia de nuestros hospedajes.',
      inLanguage: 'es-CO',
      publisher: { '@id': ORGANIZACION['@id'] },
      breadcrumb: { '@id': `${url('/blog')}#miga` },
      blogPost: publicados.map((a) => ({
        '@type': 'BlogPosting',
        '@id': `${url(a.ruta)}#articulo`,
        headline: a.titulo,
        description: a.descripcion,
        url: url(a.ruta),
        datePublished: a.publicado,
        dateModified: a.modificado,
        author: { '@type': 'Organization', name: a.autor },
      })),
    },
    ORGANIZACION,
    migaDePan([
      { nombre: 'Inicio', ruta: '/' },
      { nombre: 'Blog', ruta: '/blog' },
    ], `${url('/blog')}#miga`),
  ],
};
---

<Base
  titulo="Blog sobre Zipaquirá | Atheron Suite"
  descripcion="Artículos prácticos de Atheron sobre Zipaquirá: cómo llegar desde Bogotá, cuántos días quedarse y la historia de nuestros hospedajes."
  ruta="/blog"
  ogDescripcion="Artículos prácticos para planear tu viaje a Zipaquirá."
  jsonLd={fichaBlog}
  hojasExtra={['blog-editorial']}
>

  <Cabecera enlaces={menuBlog} cta={{ ...ctaDisponibilidad, origen: 'blog' }} actual="/blog" />

  <main id="contenido">

    <section class="hero hero--interior blog-portada">
      <div class="contenedor blog-portada__composicion">
        <div class="hero__contenido blog-portada__texto">
          <span class="hero__etiqueta">Blog de Atheron</span>
          <h1 class="hero__titulo">Historias y guías prácticas desde Zipaquirá</h1>
          <p class="hero__texto">
            Respuestas concretas para planear el viaje —cómo llegar, cuánto tiempo
            quedarse, dónde dormir— y la historia de cómo trabajamos. Para descubrir
            qué ver en la ciudad, entra a la Guía Atheron.
          </p>
          <div class="grupo-botones">
            <a class="boton boton--acento boton--grande" href="/guia-zipaquira">Explorar la Guía Atheron</a>
            <a class="boton boton--claro boton--grande" href="/hospedajes">Ver hospedajes</a>
          </div>
        </div>

        <nav class="blog-portada__mapa" aria-label="Recorrido sugerido">
          <p class="blog-portada__sello">Recorrido sugerido</p>
          <ol class="blog-ruta">
            {recorrido.map((r) => (
              <li>
                <a href={r.href}>
                  <span class="blog-ruta__paso">{r.paso}</span>
                  <span class="blog-ruta__texto"><strong>{r.titulo}</strong><small>{r.texto}</small></span>
                </a>
              </li>
            ))}
            <li>
              <a {...atributosWhatsApp(WA_BLOG, { origen: 'blog_indice_recorrido' })}>
                <span class="blog-ruta__paso">04</span>
                <span class="blog-ruta__texto"><strong>WhatsApp</strong><small>Consulta disponibilidad para tus fechas</small></span>
              </a>
            </li>
          </ol>
        </nav>
      </div>
    </section>

    <section class="seccion" id="articulos">
      <div class="contenedor">
        <div class="encabezado-seccion">
          <span class="etiqueta">Publicados</span>
          <h2>Artículos del blog</h2>
        </div>

        <div class="blog-lista">
          {publicados.map((a) => (
            <article class="tarjeta blog-articulo aparecer">
              <div class="blog-articulo__banda" aria-hidden="true">
                <span>{a.rotulo}</span>
              </div>
              <div class="tarjeta__cuerpo">
                <p class="tarjeta-articulo__meta">
                  Actualizado el <time datetime={a.modificado}>{fechaLarga(a.modificado)}</time>
                </p>
                <h3 class="tarjeta__titulo"><a href={a.ruta}>{a.tituloCorto}</a></h3>
                <p class="texto-suave">{a.descripcion}</p>
                <div class="tarjeta__pie">
                  <a class="boton boton--contorno" href={a.ruta}>Leer el artículo</a>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    {/* ==========================================================
         EN PREPARACION
         Sin enlaces: no existen. La lista vive en src/data/blog.ts
         y es la misma que cierra la guia practica.
         ========================================================== */}
    <section class="seccion seccion--alterna" id="proximos">
      <div class="contenedor">
        <div class="encabezado-seccion">
          <span class="etiqueta">Próximamente</span>
          <h2>En preparación</h2>
          <p class="texto-suave" style="margin-top: var(--esp-2);">
            Los publicamos cuando cada dato esté verificado. Mientras tanto, ya
            están disponibles la <a class="blog-enlace" href="/guia-zipaquira">Guía Atheron de Zipaquirá</a>
            {' '}y la <a class="blog-enlace" href="/zipaquira/catedral-de-sal">guía de la Catedral de Sal</a>.
          </p>
        </div>

        <ul class="blog-proximos">
          {proximosArticulos.map((p) => (
            <li>
              <span class="blog-proximos__tema">{p.tema}</span>
              <span class="blog-proximos__titulo">{p.titulo}</span>
              <span class="blog-proximos__estado">En preparación</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="seccion">
      <div class="contenedor">
        <div class="cta-final aparecer">
          <h2>¿Vienes a Zipaquirá?</h2>
          <p>Cuéntanos fechas y número de huéspedes, y te ayudamos a elegir el hospedaje que encaja con tu plan.</p>
          <div class="grupo-botones grupo-botones--centrado">
            <a class="boton boton--whatsapp boton--grande"
               {...atributosWhatsApp(WA_BLOG, { origen: 'blog_indice' })}>
              Escribir por WhatsApp
            </a>
            <a class="boton boton--claro boton--grande" href="/hospedajes">Ver los hospedajes</a>
          </div>
        </div>
      </div>
    </section>

  </main>

  <Pie />
  <BotonFlotante mensaje={WA_BLOG} origen="blog_flotante" />

</Base>
