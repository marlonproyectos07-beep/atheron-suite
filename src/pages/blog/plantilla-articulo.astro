---
/* ============================================================
   PLANTILLA DE ARTICULO

   CORRECCION DE UN FALLO QUE VENIA DE PRODUCCION:
   esta pagina estaba publicada SIN noindex y con la canonica
   apuntando a "https://hotelesatheron.com/blog/[[ARCHIVO]]",
   una direccion que no existe. Google podia llegar a ella
   (esta enlazada desde la guia de Zipaquira) y encontrarse un
   texto de relleno que dice "[[Responde la pregunta...]]" con
   una canonica rota. Eso es exactamente el "contenido delgado"
   que castiga a todo el dominio.

   Ahora lleva indexable={false} y su canonica es correcta.

   NOTA: en la Etapa 3 esta plantilla desaparece. Con el panel,
   crear un articulo sera pulsar "Nuevo" y rellenar campos; no
   hara falta una pagina-plantilla publicada en internet.
   ============================================================ */

import Base from '../../layouts/Base.astro';
import Cabecera from '../../components/Cabecera.astro';
import Pie from '../../components/Pie.astro';
import BotonFlotante from '../../components/BotonFlotante.astro';
import { menuBlog, ctaDisponibilidad } from '../../data/navegacion';
---

<Base
  titulo="[[Titulo con la palabra clave]] | Atheron Suite"
  descripcion="[[Resumen de 150 caracteres que responda la pregunta. Esto es lo que se lee en Google.]]"
  ruta="/blog/plantilla-articulo"
  ogTipo="article"
  ogTitulo="[[Titulo]]"
  ogDescripcion="[[Resumen corto]]"
  indexable={false}
  avisoBorrador="PLANTILLA DE ARTICULO. Reemplaza lo que esta entre [[corchetes]]."
>

  <Cabecera enlaces={menuBlog} cta={ctaDisponibilidad} actual="/blog" />

  <main id="contenido">

    <section class="seccion">
      <div class="contenedor">
        <article class="articulo">

          <p class="articulo__meta">
            <span><a href="/blog">Blog</a></span>
            <span>[[Fecha]]</span>
            <span>[[N]] min de lectura</span>
          </p>

          {/* El H1 debe ser la pregunta o la busqueda, casi literal */}
          <h1>[[Titulo: la pregunta que responde este articulo]]</h1>

          {/* LA RESPUESTA VA AQUI, NO AL FINAL */}
          <div class="respuesta-rapida">
            <strong>En corto</strong>
            [[Responde la pregunta completa en 3 o 4 lineas, con datos
            concretos. Si alguien solo lee esto, ya tiene su respuesta.
            Este bloque es el que hace que un asistente de IA te cite.]]
          </div>

          <p>[[Parrafo de contexto: para quien es util este articulo.]]</p>

          <h2>[[Subtitulo que sea otra pregunta real]]</h2>
          <p>[[Desarrollo con datos concretos.]]</p>

          <h2>[[Otro subtitulo]]</h2>
          <p>[[Desarrollo.]]</p>

          {/* Las tablas funcionan muy bien: son faciles de leer para
               una persona y faciles de extraer para una IA */}
          <table>
            <thead>
              <tr><th>[[Columna 1]]</th><th>[[Columna 2]]</th></tr>
            </thead>
            <tbody>
              <tr><td>[[dato]]</td><td>[[dato]]</td></tr>
            </tbody>
          </table>

          <h2>[[Subtitulo final]]</h2>
          <p>[[Cierre.]]</p>

          {/* ==========================================================
               PUENTE AL NEGOCIO
               Un articulo informativo debe llevar al hospedaje sin
               parecer un anuncio. Se hace al final y en una linea.
               ========================================================== */}
          <div class="cluster">
            <h3>Vas a quedarte en Zipaquira?</h3>
            <p class="texto-suave">
              Administramos siete hospedajes en el municipio.
              <a href="/hospedajes">Miralos aqui</a>
              o escribenos y te ayudamos a elegir.
            </p>
            <div class="grupo-botones" style="margin-top: var(--esp-2);">
              <a class="boton boton--whatsapp" href="/#contacto"
                 data-whatsapp="Hola, lei el articulo [[Titulo]] y quiero consultar disponibilidad.">
                Consultar por WhatsApp
              </a>
            </div>
          </div>

          {/* Enlaces al resto del grupo tematico */}
          <div class="cluster" style="margin-top: var(--esp-3);">
            <h3>Relacionado</h3>
            <ul>
              <li><a href="/blog/guia-de-zipaquira">Guia completa de Zipaquira</a></li>
              <li>[[Enlace a otro articulo del cluster]]</li>
            </ul>
          </div>

        </article>
      </div>
    </section>

  </main>

  <Pie textoVuelta="Volver al blog" hrefVuelta="/blog" />

  <BotonFlotante
    href="/#contacto"
    mensaje="Hola, quiero informacion sobre los hospedajes de Atheron Suite."
  />

</Base>
