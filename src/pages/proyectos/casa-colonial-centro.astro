---
/* ============================================================
   CASA COLONIAL CENTRO BY ATHERON — pagina de proyecto

   BORRADOR PRIVADO. NO PUBLICAR SIN APROBACION ESCRITA.

   Estado con el que sale a la calle esta pagina:

     - noindex, nofollow  (Base.astro, indexable={false} y
                           seguirEnlaces={false})
     - FUERA del sitemap  (src/pages/sitemap.xml.ts no la lista)
     - sin enlace desde la navegacion ni desde la portada
     - accesible solo por la vista previa de Vercel

   Los cuatro puntos van juntos a proposito. Quitar solo uno no
   publica la pagina, pero deja el sitio en un estado incoherente:
   una direccion indexable que nadie enlaza, o un sitemap que apunta
   a una pagina con noindex. Cuando llegue la aprobacion se repasan
   los cuatro de una vez, mas el interruptor BORRADOR de
   src/data/casa-colonial-centro.ts.

   DE DONDE SALE EL CONTENIDO
   De src/data/casa-colonial-centro.ts, y de ningun otro sitio. Esta
   pagina no reutiliza fotos, capacidades, tarifas, habitaciones ni
   textos de Hotel Atheron Suite, Casa Algarra, Casa Neusa ni de
   ningun otro hospedaje.

   LO QUE ESTA PAGINA NO HACE
   No pide dinero. No lleva formulario de aportes, pasarela de pago,
   checkout, suscripcion, transferencia, reserva de participacion,
   calculo de rentabilidad ni simulador de retorno. No promete
   retornos. La unica accion posible es escribir por WhatsApp.
   ============================================================ */

import Base from '../../layouts/Base.astro';
import Cabecera from '../../components/Cabecera.astro';
import Pie from '../../components/Pie.astro';
import BotonFlotante from '../../components/BotonFlotante.astro';
import AvisoInformativo from '../../components/AvisoInformativo.astro';
import ProyectoEstado from '../../components/ProyectoEstado.astro';
import ProyectoGaleria from '../../components/ProyectoGaleria.astro';
import ProyectoComparador from '../../components/ProyectoComparador.astro';
import ProyectoUnidad from '../../components/ProyectoUnidad.astro';
import ProyectoFoto from '../../components/ProyectoFoto.astro';

import { recorridoVisible, cierreRecorrido } from '../../data/casa-colonial-recorrido';
import { menuHospedajes } from '../../data/navegacion';
import { atributosWhatsApp, enlaceWhatsApp } from '../../data/whatsapp';
import {
  BORRADOR,
  RUTA,
  NOMBRE,
  NOMBRE_CORTO,
  UBICACION_PUBLICA,
  MENSAJE_GENERAL,
  AVISO_INFORMATIVO,
  ETIQUETA_GALERIA_REAL,
  HUECOS_GALERIA,
  GRUPOS_GALERIA,
  fechaEnTexto,
  seo,
  hero,
  heroVisionFachada,
  ubicacion,
  historia,
  estadoActual,
  galeriaEstadoActual,
  transformacion,
  unidades,
  modelo,
  /* alianzas, bitacora y cierre siguen exportados en los datos y sin
     usar aqui: sus secciones se retiraron de la maqueta el 12/09/2026.
     Se dejan fuera del import para que no queden como dependencias
     fantasma, y vuelven con una linea cuando direccion los pida. */
  aviso,
} from '../../data/casa-colonial-centro';

/* La cabecera es la del sitio, con el menu del listado: esta pagina
   no se anade al menu, pero si ofrece la salida hacia el sitio. */
/* El href se construye con EL MISMO mensaje que lleva data-whatsapp.
   Antes apuntaba al enlace de respaldo generico, asi que el boton
   decia una cosa -conversar sobre el proyecto- y abria WhatsApp con
   otra -consultar disponibilidad de un hospedaje-. */
const ctaCabecera = {
  texto: 'Conversar por WhatsApp',
  href: enlaceWhatsApp(MENSAJE_GENERAL),
  clase: 'boton--whatsapp',
  whatsapp: MENSAJE_GENERAL,
  externo: true,
};


const avisoBorrador = BORRADOR
  ? 'Borrador privado del proyecto Casa Colonial Centro. No indexado, sin enlazar y sin publicar. Pendiente de aprobación de Marlon y ChatGPT.'
  : null;

/* El hero conceptual aprobado por dirección el 11/09/2026. La ruta
   sale del catálogo de fotos, no escrita a mano: antes eran tres URL
   de un CDN externo puestas aquí, y un enlace temporal en la maqueta
   es un hero que un día desaparece sin error visible. */

/* ============================================================
   DATOS ESTRUCTURADOS

   Solo tres tipos, y ninguno de ellos declara un negocio abierto:
   WebPage (esto es una pagina), Organization (quien la publica) y
   BreadcrumbList (donde esta dentro del sitio).

   LO QUE NO SE MARCA, Y POR QUE:
   Hotel, LodgingBusiness, Restaurant, FoodEstablishment, Offer,
   Product, AggregateRating, Review, PriceSpecification, Event y
   OpeningHoursSpecification describirian servicios que todavia no
   existen. Marcar como existente algo que es una propuesta es
   declararle a Google un negocio que no puede visitar. BarOrPub no
   se usa nunca: la cuarta unidad es un restaurante gastrobar.

   El dominio no se escribe a mano: sale de astro.config.mjs, igual
   que la canonica.

   MIGA DE PAN: "Proyectos" va SIN direccion a proposito. La ruta
   /proyectos no existe como pagina, y crear una pagina publica
   vacia solo para que la miga tenga a donde apuntar seria peor
   que dejar el escalon sin enlace. Queda como pendiente.
   ============================================================ */
const urlPagina = new URL(RUTA, Astro.site).href;
const urlSitio = new URL('/', Astro.site).href;

const fichaPagina = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': `${urlPagina}#pagina`,
      url: urlPagina,
      name: seo.titulo,
      description: seo.descripcion,
      inLanguage: 'es-CO',
      isPartOf: { '@id': `${urlSitio}#organizacion` },
      breadcrumb: { '@id': `${urlPagina}#miga` },
    },
    {
      '@type': 'Organization',
      '@id': `${urlSitio}#organizacion`,
      name: 'Atheron Suite',
      url: urlSitio,
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${urlPagina}#miga`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: urlSitio },
        { '@type': 'ListItem', position: 2, name: 'Proyectos' },
        { '@type': 'ListItem', position: 3, name: NOMBRE_CORTO, item: urlPagina },
      ],
    },
  ],
};
---

<Base
  titulo={seo.titulo}
  descripcion={seo.descripcion}
  ruta={RUTA}
  {/* EL INTERRUPTOR. Mientras BORRADOR sea true la pagina sale con
      noindex, nofollow. Al ponerlo en false -y solo entonces- pasa a
      index, follow. La canonica no depende de esto: la construye
      Base.astro desde la ruta y el dominio, asi que ya es la correcta
      hoy y lo seguira siendo despues.

      Falta un paso mas, y es deliberado que sea manual: anadir la ruta
      a src/pages/sitemap.xml.ts. Publicar es una decision, no un
      efecto secundario de cambiar una variable. */}
  indexable={!BORRADOR}
  seguirEnlaces={!BORRADOR}
  imagen={seo.imagen}
  imagenAlt={seo.imagenAlt}
  avisoBorrador={avisoBorrador}
  jsonLd={fichaPagina}
  hojasExtra={['proyecto-foto', 'proyecto-casa-colonial']}
>
  <Cabecera enlaces={menuHospedajes} cta={ctaCabecera} />

  <main id="contenido">

    {/* ============================================================
         1. HERO

         Fotografia interior real, con el balcon hacia el centro
         historico. La fachada no se usa en ningun sitio: ni aqui,
         ni en la galeria, ni al compartir el enlace.

         Es la unica imagen de la pagina que se pide con prioridad
         (prioritaria), porque es la primera que se ve y la que
         Lighthouse mide como LCP. Todas las demas van diferidas.
         ============================================================ */}
    <section class="proyecto-hero-aprobado" aria-labelledby="proyecto-hero-titulo">
      <a
        class="proyecto-hero-aprobado__enlace"
        href={`#${transformacion.id}`}
        aria-label="Descubrir la transformación de Casa Colonial Centro"
      >
        {/* El hero va a sangre, asi que el navegador necesita tantos
            pixeles como ancho tenga la pantalla y ni uno mas. Las
            variantes las genera el prebuild (optimiza-selector.mjs);
            el archivo de 1536 queda de respaldo y para escritorio. */}
        <img
          class="proyecto-hero-aprobado__imagen"
          src={heroVisionFachada.ruta}
          srcset={[
            `${heroVisionFachada.ruta.replace(/\.webp$/, '-600.webp')} 600w`,
            `${heroVisionFachada.ruta.replace(/\.webp$/, '-800.webp')} 800w`,
            `${heroVisionFachada.ruta.replace(/\.webp$/, '-1100.webp')} 1100w`,
            `${heroVisionFachada.ruta} ${heroVisionFachada.ancho}w`,
          ].join(', ')}
          sizes="100vw"
          alt={heroVisionFachada.alt}
          width={heroVisionFachada.ancho}
          height={heroVisionFachada.alto}
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </a>

      {/* La clase es "solo-lectores", la del sitio. Antes decía
          "sr-only", que no existe en ninguna hoja: el h1 se pintaba
          visible, en texto oscuro sobre el fondo oscuro del hero. */}
      <h1 id="proyecto-hero-titulo" class="solo-lectores">Casa Colonial Centro — Una casa con historia. Una nueva visión.</h1>
      <p class="proyecto-hero-aprobado__rotulo">Representación conceptual · Proyecto en desarrollo</p>
    </section>

    {/* ============================================================
         2. UBICACION / CONTEXTO
         Donde esta la casa, antes de entrar en ella. Se ensena desde
         dentro hacia el centro historico: la direccion exacta no se
         publica todavia.
         ============================================================ */}
    {/* Una sola fotografia aprobada, asi que NO se monta una rejilla de
        dos columnas: se centra y se agranda. Antes ocupaba 28rem
        pegada a la izquierda y dejaba media pantalla en blanco. */}
    <section class="seccion parada" id={ubicacion.id} aria-labelledby="ubicacion-titulo">
      <div class="contenedor aparecer">
        <div class="encabezado-seccion">
          <span class="etiqueta">{ubicacion.ceja}</span>
          <h2 id="ubicacion-titulo">{ubicacion.titulo}</h2>
          <p class="texto-grande texto-suave" style="margin-top: var(--esp-2);">{ubicacion.texto}</p>
        </div>

        <div class="bloque-imagen-unica">
          <p class="comparativa__momento">Estado actual</p>
          <ProyectoFoto foto={ubicacion.foto} medidas="(min-width: 768px) 46rem, 100vw" anchos={[400, 700]} />
        </div>
      </div>
    </section>

    {/* ============================================================
         3 A 11. EL RECORRIDO — HOY / VISION ATHERON

         Fachada, acceso desde el parque, corredor, escalera y llegada
         al piso 2. Dos archivos por bloque, nunca una imagen
         combinada, y el texto en HTML.

         La fachada ya no se maqueta a mano aqui: era el unico bloque
         que escribia sus rotulos en el HTML -y por tanto el unico que
         podia quedarse sin ellos al copiarlo-. Ahora sale del mismo
         recorrido que los demas.

         LOS ROTULOS NO SE ESCRIBEN AQUI. Los pone ProyectoFoto a
         partir del tipo de cada imagen: REAL lleva "fotografia real",
         CONCEPTUAL lleva el sello encima, el rotulo debajo y el aviso
         de que el diseno puede cambiar. Escribirlos a mano en esta
         maqueta es exactamente como se acaba ensenando una imagen
         generada sin advertir que lo es.

         EN MOVIL se apilan en el orden del documento: primero HOY,
         despues VISION ATHERON. El orden lo da el HTML, no el CSS,
         asi que tambien es el orden que oye un lector de pantalla.
         ============================================================ */}
    {recorridoVisible.map((bloque, indice) => (
      <section
        class:list={['seccion', 'parada', indice % 2 === 1 && 'seccion--alterna']}
        id={bloque.id}
        aria-labelledby={`${bloque.id}-titulo`}
      >
        <div class="contenedor aparecer">
          <div class="encabezado-seccion">
            <span class="etiqueta">{bloque.ceja}</span>
            <h2 id={`${bloque.id}-titulo`}>{bloque.titulo}</h2>
            <p class="texto-grande texto-suave" style="margin-top: var(--esp-2);">
              {bloque.texto}
            </p>
          </div>

          {/* Los datos de la unidad, cuando los hay. Ninguna cifra se
              escribe aqui: vienen del archivo de datos, y alli solo
              entra lo que direccion aprobo por escrito. */}
          {bloque.ficha && (
            <dl class="comparativa__datos">
              {bloque.ficha.map((dato) => (
                <div class="comparativa__dato">
                  <dt>{dato.etiqueta}</dt>
                  <dd>{dato.valor}</dd>
                </div>
              ))}
            </dl>
          )}

          {/* ============================================================
               DOS PATRONES, Y NINGUN TERCERO

               A) Hay pareja -> comparativa 50/50: UNA real contra UNA
                  vision. Si el espacio llego con mas tomas reales -la
                  201 tiene tres, la suite 207 cuatro-, las demas NO se
                  apilan en la columna izquierda: eso la estiraba al
                  triple de la derecha y dejaba media pantalla en
                  blanco. Van en una tira aparte, debajo y a todo el
                  ancho.

               B) No hay pareja -> una sola imagen, centrada y grande.
                  No se pinta una rejilla de dos columnas con un hueco
                  al lado, ni se reserva el sitio de la imagen que
                  falta, ni se repite una foto para rellenar.
               ============================================================ */}
          {bloque.disposicion === 'apilado' && bloque.vision ? (
            /* ============================================================
                 APILADO — primero el estado actual, despues la vision

                 Solo la terraza. Sus fotografias son 539 x 1200 y el
                 render 4:3: enfrentadas en dos columnas quedaba una
                 franja estrecha junto a una postal, y recortar la
                 vertical para igualarlas se comeria media toma.

                 Arriba las reales, centradas y a su proporcion. Debajo
                 el render, mas ancho, porque es horizontal y lo
                 aprovecha. Las dos imagenes siguen siendo archivos
                 separados y cada una con su rotulo en HTML.
                 ============================================================ */
            <div class="apilado">
              <div class="apilado__real">
                <p class="comparativa__momento">Estado actual</p>
                <ProyectoFoto foto={bloque.actuales[0]} medidas="(min-width: 768px) 24rem, 100vw" anchos={[400, 700]} />
              </div>

              <div class="apilado__vision">
                <p class="comparativa__momento comparativa__momento--vision">Visión del proyecto</p>
                <ProyectoFoto foto={bloque.vision} medidas="(min-width: 768px) 56rem, 100vw" anchos={[400, 700]} />
              </div>
            </div>
          ) : bloque.actuales.length > 0 && bloque.vision ? (
            /* Una real contra una vision, y nada mas. Varios espacios
               llegaron con tres o cuatro tomas del mismo sitio -la
               201, el bano modelo, la suite 207, el gastrobar-. Se
               probo ensenarlas todas en una tira debajo y direccion lo
               descarto: claridad, no cantidad. Se pinta la toma de
               establecimiento, que es la que explica el espacio, y las
               demas se quedan declaradas en los datos sin renderizar,
               listas para cuando hagan falta. */
            <div class="comparativa">
              <div class="comparativa__item">
                <p class="comparativa__momento">Estado actual</p>
                <ProyectoFoto foto={bloque.actuales[0]} medidas="(min-width: 768px) 44vw, 100vw" anchos={[400, 700]} />
              </div>
              <div class="comparativa__item">
                <p class="comparativa__momento comparativa__momento--vision">Visión del proyecto</p>
                <ProyectoFoto foto={bloque.vision} medidas="(min-width: 768px) 44vw, 100vw" anchos={[400, 700]} />
              </div>
            </div>
          ) : (
            <div class="bloque-imagen-unica">
              {bloque.vision ? (
                <>
                  <p class="comparativa__momento comparativa__momento--vision">Visión del proyecto</p>
                  <ProyectoFoto foto={bloque.vision} medidas="(min-width: 768px) 46rem, 100vw" anchos={[400, 700]} />
                </>
              ) : (
                <>
                  <p class="comparativa__momento">Estado actual</p>
                  <ProyectoFoto foto={bloque.actuales[0]} medidas="(min-width: 768px) 46rem, 100vw" anchos={[400, 700]} />
                </>
              )}
            </div>
          )}

          {bloque.nota && <p class="comparativa__nota">{bloque.nota}</p>}
        </div>
      </section>
    ))}

    {/* ============================================================
         2. HISTORIA

         PENDIENTE JURIDICO: los textos relacionados con contrato,
         opcion preferente de compra, permisos y autoridades estan
         pendientes de aprobacion juridica antes de publicacion
         publica. Por eso aqui NO aparecen el canon, la identidad de
         los propietarios, las condiciones contractuales privadas, el
         precio futuro de compra, la inversion realizada, los montos
         requeridos ni los porcentajes de participacion.
         ============================================================ */}
    <section class="seccion" id={historia.id}>
      <div class="contenedor aparecer">
        <div class="encabezado-seccion">
          <span class="etiqueta">{historia.ceja}</span>
          <h2>{historia.titulo}</h2>
        </div>

        {/* La nota "Redaccion sujeta a revision juridica" se retira, y
            no por maquillar: existia porque el texto anterior hablaba
            del acuerdo de arrendamiento con los propietarios. El texto
            nuevo aprobado el 12/09/2026 no menciona el acuerdo, ni sus
            condiciones, ni a los propietarios, asi que ya no hay nada
            ahi que necesite pasar por abogados. El pendiente juridico
            SIGUE VIVO para lo que sigue guardado en los datos -canon,
            opcion de compra, montos-, que continua sin publicarse. */}

        <div class="columna-texto">
          {historia.parrafos.map((parrafo) => <p>{parrafo}</p>)}
        </div>

        <blockquote class="destacado">{historia.destacado}</blockquote>

        {/* Historia y ubicacion. La ubicacion se ensena desde
            dentro hacia el centro historico: la direccion exacta
            no se publica todavia. */}
        {historia.fotos.length > 0 && (
          <div class="pareja-fotos">
            {historia.fotos.map((foto) => (
              <ProyectoFoto foto={foto} medidas="(min-width: 900px) 33rem, 100vw" />
            ))}
          </div>
        )}
      </div>
    </section>

    {/* ============================================================
         3. LA CASA HOY
         Solo fotografia real. El componente descarta cualquier
         imagen conceptual que se cuele en los datos.
         ============================================================ */}
    <section class="seccion seccion--alterna" id={estadoActual.id}>
      <div class="contenedor aparecer">
        <div class="encabezado-seccion">
          <span class="etiqueta">{estadoActual.ceja}</span>
          <h2>{estadoActual.titulo}</h2>
          <p class="texto-grande texto-suave" style="margin-top: var(--esp-2);">
            {estadoActual.texto}
          </p>
        </div>

        <ProyectoEstado estado={estadoActual.estado} />

        <ProyectoGaleria
          fotos={galeriaEstadoActual}
          etiqueta={ETIQUETA_GALERIA_REAL}
          huecos={HUECOS_GALERIA}
          grupos={GRUPOS_GALERIA}
        />
      </div>
    </section>

    {/* ============================================================
         4. TRANSFORMACION
         Tres estados por espacio, con botones y sin deslizador.
         Ver el porque en src/components/ProyectoComparador.astro.
         ============================================================ */}
    <section class="seccion" id={transformacion.id}>
      <div class="contenedor aparecer">
        <div class="encabezado-seccion">
          <span class="etiqueta">{transformacion.ceja}</span>
          <h2>{transformacion.titulo}</h2>
          <p class="texto-grande texto-suave" style="margin-top: var(--esp-2);">
            {transformacion.texto}
          </p>
        </div>

        <ProyectoEstado
          estado={transformacion.estado}
          nota="Los espacios se cargarán con el manifiesto fotográfico aprobado."
        />

        <ProyectoComparador bloques={transformacion.bloques} />
      </div>
    </section>

    {/* ============================================================
         5. CUATRO EXPERIENCIAS
         ============================================================ */}
    <section class="seccion seccion--alterna" id={unidades.id}>
      <div class="contenedor aparecer">
        <div class="encabezado-seccion">
          <span class="etiqueta">{unidades.ceja}</span>
          <h2>{unidades.titulo}</h2>
          <p class="texto-grande texto-suave" style="margin-top: var(--esp-2);">
            {unidades.intro}
          </p>
        </div>

        <div class="grid grid--4">
          {unidades.lista
            .filter((unidad) => unidad.visible)
            .map((unidad) => <ProyectoUnidad unidad={unidad} />)}
        </div>
      </div>
    </section>

    {/* ============================================================
         RESUMEN DEL RECORRIDO — LAS FORMAS DE CREAR EXPERIENCIAS

         Movida aqui el 12/09/2026. Estaba justo despues del recorrido,
         en mitad de la experiencia, y direccion la queria funcionando
         como resumen de lo que el visitante ACABA de ver. Ahora cierra
         la presentacion, antes del modelo.

         Siete frentes del proyecto, sin una sola cifra: ni tarifas,
         ni rentabilidad, ni aforos, ni fecha de apertura. Es lo que
         la casa puede albergar, no una oferta.
         ============================================================ */}
    <section class="seccion formas" id={cierreRecorrido.id} aria-labelledby="formas-titulo">
      <div class="contenedor aparecer">
        <div class="encabezado-seccion">
          <span class="etiqueta">{cierreRecorrido.ceja}</span>
          <h2 id="formas-titulo">{cierreRecorrido.titulo}</h2>
          <p class="texto-grande texto-suave" style="margin-top: var(--esp-2);">
            {cierreRecorrido.texto}
          </p>
        </div>

        <ul class="formas__rejilla">
          {cierreRecorrido.tarjetas.map((t) => (
            <li class="formas__tarjeta">
              <h3 class="formas__titulo">{t.titulo}</h3>
              <p class="formas__texto">{t.texto}</p>
            </li>
          ))}
        </ul>

        <div class="formas__accion">
          <a
            class="boton boton--grande boton--whatsapp"
            href={enlaceWhatsApp(MENSAJE_GENERAL)}
            data-whatsapp={MENSAJE_GENERAL}
            data-evento="ccc_whatsapp_click"
            rel="noopener"
            target="_blank"
          >Conversar sobre el proyecto</a>
        </div>
      </div>
    </section>
    {/* ============================================================
         6. MODELO ATHERON
         Sin cifras ni porcentajes, y sin dar por seleccionados
         operadores ni inversionistas.
         ============================================================ */}
    <section class="seccion seccion--oscura" id={modelo.id}>
      <div class="contenedor aparecer">
        <div class="encabezado-seccion">
          <span class="etiqueta">{modelo.ceja}</span>
          <h2>{modelo.titulo}</h2>
        </div>

        <ProyectoEstado estado={modelo.estado} />

        <div class="modelo">
          <div class="modelo__cara">
            <h3 class="modelo__titulo">Lo que ve el público</h3>
            <ul class="modelo__lista">
              {modelo.publico.map((punto) => <li>{punto}</li>)}
            </ul>
          </div>

          <div class="modelo__cara">
            <h3 class="modelo__titulo">Cómo funciona por dentro</h3>
            <ul class="modelo__lista">
              {modelo.interno.map((punto) => <li>{punto}</li>)}
            </ul>
            <ul class="modelo__unidades">
              {unidades.lista.map((unidad) => (
                <li>{unidad.nombreAdministrativo}</li>
              ))}
            </ul>
          </div>
        </div>

        <div class="columna-texto" style="margin-top: var(--esp-4);">
          {modelo.parrafos.map((parrafo) => <p>{parrafo}</p>)}
        </div>

        {/* La vision integrada: por donde se entra a las cuatro
            unidades. Representacion conceptual, rotulada. */}
        {modelo.foto && (
          <ProyectoFoto
            foto={modelo.foto}
            clase="foto-proyecto--centrada"
            medidas="(min-width: 900px) 28rem, 100vw"
          />
        )}
      </div>
    </section>
    {/* ============================================================
         9. AVISO INFORMATIVO
         Texto exacto, en el HTML inicial, legible sin interaccion y
         antes del cierre de la pagina.
         ============================================================ */}
    <section class="seccion" id={aviso.id}>
      <div class="contenedor aparecer">
        <AvisoInformativo texto={aviso.texto} titulo={aviso.titulo} />
      </div>
    </section>
