{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/hospedajes/plantilla-hospedaje",
      "destination": "/hospedajes",
      "permanent": true
    },
    {
      "source": "/blog/plantilla-articulo",
      "destination": "/blog",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
